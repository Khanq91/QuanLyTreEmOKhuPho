@{
    ViewBag.Title = "GhiNhanUngHo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ThongTinManhThuongQuan);
}

<link rel="stylesheet" href="~/Content/css/Site.css" />
<link rel="stylesheet" href="~/Content/css/GhiNhanUngHo.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
    .back-button {
        margin-bottom: 10px;
    }

    .btn-back {
        display: inline-block;
        background-color: #f0f0f0;
        color: #333;
        padding: 8px 14px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: background-color 0.2s ease;
    }

        .btn-back:hover {
            background-color: #e2e2e2;
        }

    /* Styles cho upload file */
    .file-upload-wrapper {
        position: relative;
        margin-top: 8px;
    }

    .file-upload-input {
        display: none;
    }

    .file-upload-label {
        display: inline-block;
        padding: 10px 20px;
        background-color: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        width: 100%;
    }

        .file-upload-label:hover {
            background-color: #e9ecef;
            border-color: #adb5bd;
        }

        .file-upload-label i {
            margin-right: 8px;
            color: #6c757d;
        }

    .file-preview-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .file-preview-item {
        position: relative;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 8px;
        background-color: #f8f9fa;
        overflow: hidden;
    }

    .file-preview-image {
        width: 100%;
        height: 100px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 5px;
    }

    .file-preview-icon {
        width: 100%;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #e9ecef;
        border-radius: 4px;
        margin-bottom: 5px;
    }

        .file-preview-icon i {
            font-size: 40px;
            color: #6c757d;
        }

    .file-preview-name {
        font-size: 12px;
        color: #495057;
        word-break: break-word;
        margin-bottom: 3px;
    }

    .file-preview-size {
        font-size: 11px;
        color: #6c757d;
    }

    .file-remove-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease;
        z-index: 10;
    }

        .file-remove-btn:hover {
            background-color: #c82333;
        }

    .file-info-text {
        font-size: 12px;
        color: #6c757d;
        margin-top: 5px;
    }
    .file-evidence-select {
        width: 100%;
        padding: 4px;
        font-size: 11px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        margin-top: 5px;
    }
</style>

<div class="content-wrapper">
    <div class="back-button">
        <a href="@Url.Action("ManhThuongQuan", "ManhThuongQuan")" class="btn-back">
            <i class="fa-solid fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="form-section">
        <h2 class="section-title">
            <span><i class="fa-solid fa-file"></i></span>
            Thông tin ủng hộ
        </h2>
        <div id="alertContainer"></div>
        <form id="donationForm" method="post" action="@Url.Action("GhiNhanUngHo", "ManhThuongQuan")" enctype="multipart/form-data">
            <div class="form-group donor-search">
                <label>Mạnh thường quân <span class="required">*</span></label>
                <input type="text" id="donorSearch" placeholder="Tìm kiếm hoặc nhập tên..." autocomplete="off">
                <input type="hidden" id="ManhThuongQuanId" name="ManhThuongQuanId">
                <div class="donor-suggestions" id="donorSuggestions"></div>
            </div>

            <div class="form-group">
                <label>Số tiền (VNĐ) <span class="required">*</span></label>
                <input type="number" name="SoTien" id="amount" placeholder="0" min="0" step="1000" required>
            </div>
            <div class="form-group">
                <label>Số lượng phần quà <span class="required">*</span></label>
                <input type="number" name="SoLuongVatPham" id="quantity" placeholder="0" min="1" step="1" required>
            </div>
            <div class="form-group">
                <label>Tên vật phẩm ủng hộ <span class="required">*</span></label>
                <input type="text" name="TenVatPham" id="itemName" placeholder="Tên vật phẩm ủng hộ" required>
            </div>
            <div class="form-group">
                <label>Ngày ủng hộ <span class="required">*</span></label>
                <input type="date" name="NgayUngHo" id="date" required>
            </div>

            <div class="form-group">
                <label>Loại ủng hộ</label>
                <select name="LoaiUngHo" id="method">
                    <option value="Tiền Mặt">Tiền mặt</option>
                    <option value="Chuyển Khoản">Chuyển khoản</option>
                    <option value="Hàng Hóa">Hàng hóa</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="form-group">
                <label>Đối tượng ủng hộ <span class="required">*</span></label>
                <input type="text" name="DoiTuong" id="recipient" placeholder="Đối tượng ủng hộ" required>
            </div>

            <div class="form-group">
                <label>Ghi chú</label>
                <textarea name="GhiChu" id="note" placeholder="Thông tin bổ sung..."></textarea>
            </div>

            <!-- Upload file section -->
            <div class="form-group">
                <label>Tài liệu đính kèm (Ảnh, PDF, Word, Excel...)</label>
                <div class="file-upload-wrapper">
                    <input type="file"
                           id="fileUpload"
                           name="Files"
                           class="file-upload-input"
                           multiple
                           accept="image/*,.pdf,.doc,.docx,.xls,.xlsx">
                    <label for="fileUpload" class="file-upload-label">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span>Nhấn để chọn file hoặc kéo thả vào đây</span>
                    </label>
                    <div class="file-info-text">Hỗ trợ: Ảnh (JPG, PNG), PDF, Word, Excel. Tối đa 10MB/file</div>
                </div>
                <div id="filePreviewContainer" class="file-preview-container"></div>
            </div>

            @if (ViewBag.MessageError != null)
            {
                <div class="alert alert-error" id="alertError">
                    <span>@ViewBag.MessageError</span>
                </div>
            }
            @if (ViewBag.MessageSuccess != null)
            {
                <div class="alert alert-success" id="alertSuccess">
                    <span>@ViewBag.MessageSuccess</span>
                </div>
            }

            <div class="button-group">
                <button type="button" class="btn btn-outline" onclick="resetForm()"><i class="fa-solid fa-rotate"></i> Làm mới</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-square-check"></i> Lưu ủng hộ</button>
            </div>
        </form>

    </div>
</div>
<script>
const donors = @Html.Raw(list);
const searchInput = document.getElementById('donorSearch');
const suggestionsBox = document.getElementById('donorSuggestions');
const hiddenIdField = document.getElementById('ManhThuongQuanId');
const fileInput = document.getElementById('fileUpload');
const filePreviewContainer = document.getElementById('filePreviewContainer');
let selectedFiles = [];

// Donor search functionality
searchInput.addEventListener('input', function () {
    const keyword = this.value.toLowerCase().trim();
    suggestionsBox.innerHTML = '';

    if (keyword === '') {
        suggestionsBox.classList.remove('show');
        hiddenIdField.value = '';
        return;
    }

    const matches = donors.filter(d => d.Ten && d.Ten.toLowerCase().includes(keyword));

    if (matches.length === 0) {
        suggestionsBox.innerHTML = '<div class="suggestion-item empty">Không tìm thấy kết quả</div>';
        suggestionsBox.classList.add('show');
    } else {
        matches.forEach(donor => {
            const div = document.createElement('div');
            div.classList.add('suggestion-item');
            div.innerHTML = `
                <div class="suggestion-name">${donor.Ten}</div>
                <div class="suggestion-info">
                    ${donor.Loai == "Cá nhân" ? "Cá nhân" : "Tổ chức"} • ${donor.SDT ?? "Chưa có SĐT"}
                </div>
            `;

            div.addEventListener('click', () => {
                searchInput.value = donor.Ten;
                hiddenIdField.value = donor.ManhThuongQuanId;
                suggestionsBox.classList.remove('show');
            });

            suggestionsBox.appendChild(div);
        });
        suggestionsBox.classList.add('show');
    }
});

document.addEventListener('click', function (e) {
    if (!suggestionsBox.contains(e.target) && e.target !== searchInput) {
        suggestionsBox.classList.remove('show');
    }
});

// File upload functionality
fileInput.addEventListener('change', function(e) {
    handleFiles(e.target.files);
});

// Drag and drop support
const fileUploadLabel = document.querySelector('.file-upload-label');

fileUploadLabel.addEventListener('dragover', function(e) {
    e.preventDefault();
    this.style.borderColor = '#007bff';
    this.style.backgroundColor = '#e7f3ff';
});

fileUploadLabel.addEventListener('dragleave', function(e) {
    e.preventDefault();
    this.style.borderColor = '#dee2e6';
    this.style.backgroundColor = '#f8f9fa';
});

fileUploadLabel.addEventListener('drop', function(e) {
    e.preventDefault();
    this.style.borderColor = '#dee2e6';
    this.style.backgroundColor = '#f8f9fa';
    const files = e.dataTransfer.files;
    handleFiles(files);
});

function handleFiles(files) {
    Array.from(files).forEach(file => {
        if (file.size > 10 * 1024 * 1024) {
            alert(`File "${file.name}" quá lớn. Vui lòng chọn file dưới 10MB.`);
            return;
        }

        // Thêm file với loại minh chứng mặc định
        selectedFiles.push({
            file: file,
            loaiMinhChung: '' // Mặc định chưa chọn
        });
        displayFilePreview(file, selectedFiles.length - 1);
    });
    updateFileInput();
}

function displayFilePreview(file, index) {
    const previewItem = document.createElement('div');
    previewItem.className = 'file-preview-item';
    previewItem.dataset.index = index;

    const isImage = file.type.startsWith('image/');

    // Tạo dropdown options
    const evidenceOptions = `
        <option value="">-- Chọn loại --</option>
        <option value="Biên nhận học phí">Biên nhận học phí</option>
        <option value="Xác nhận chuyển khoản">Xác nhận chuyển khoản</option>
        <option value="Biên nhận học bổng">Biên nhận học bổng</option>
        <option value="Hóa đơn y tế">Hóa đơn y tế</option>
        <option value="Biên nhận tiền hỗ trợ">Biên nhận tiền hỗ trợ</option>
        <option value="Hóa đơn điều trị">Hóa đơn điều trị</option>
        <option value="Biên nhận toàn diện">Biên nhận toàn diện</option>
        <option value="Giấy tờ khác">Giấy tờ khác</option>
    `;

    if (isImage) {
        const reader = new FileReader();
        reader.onload = function(e) {
            previewItem.innerHTML = `
                <img src="${e.target.result}" class="file-preview-image" alt="${file.name}">
                <div class="file-preview-name">${file.name}</div>
                <div class="file-preview-size">${formatFileSize(file.size)}</div>
                <select class="file-evidence-select" onchange="updateFileEvidence(${index}, this.value)">
                    ${evidenceOptions}
                </select>
                <button type="button" class="file-remove-btn" onclick="removeFile(${index})">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            `;
        };
        reader.readAsDataURL(file);
    } else {
        const icon = getFileIcon(file.name);
        previewItem.innerHTML = `
            <div class="file-preview-icon">
                <i class="${icon}"></i>
            </div>
            <div class="file-preview-name">${file.name}</div>
            <div class="file-preview-size">${formatFileSize(file.size)}</div>
            <select class="file-evidence-select" onchange="updateFileEvidence(${index}, this.value)">
                ${evidenceOptions}
            </select>
            <button type="button" class="file-remove-btn" onclick="removeFile(${index})">
                <i class="fa-solid fa-xmark"></i>
            </button>
        `;
    }

    filePreviewContainer.appendChild(previewItem);
}

function updateFileEvidence(index, loaiMinhChung) {
    if (selectedFiles[index]) {
        selectedFiles[index].loaiMinhChung = loaiMinhChung;
    }
}

function removeFile(index) {
    selectedFiles.splice(index, 1);
    updateFileInput();
    renderFilePreviews();
}

function renderFilePreviews() {
    filePreviewContainer.innerHTML = '';
    selectedFiles.forEach((item, index) => {
        displayFilePreview(item.file, index);
        // Restore selected loaiMinhChung
        setTimeout(() => {
            const select = filePreviewContainer.querySelector(`[data-index="${index}"] .file-evidence-select`);
            if (select && item.loaiMinhChung) {
                select.value = item.loaiMinhChung;
            }
        }, 100);
    });
}

function updateFileInput() {
    const dataTransfer = new DataTransfer();
    selectedFiles.forEach(item => {
        dataTransfer.items.add(item.file);
    });
    fileInput.files = dataTransfer.files;
}

function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
}

function getFileIcon(filename) {
    const ext = filename.split('.').pop().toLowerCase();
    const iconMap = {
        'pdf': 'fa-solid fa-file-pdf',
        'doc': 'fa-solid fa-file-word',
        'docx': 'fa-solid fa-file-word',
        'xls': 'fa-solid fa-file-excel',
        'xlsx': 'fa-solid fa-file-excel',
        'zip': 'fa-solid fa-file-zipper',
        'rar': 'fa-solid fa-file-zipper'
    };
    return iconMap[ext] || 'fa-solid fa-file';
}

function resetForm() {
    document.getElementById('donationForm').reset();
    searchInput.value = '';
    hiddenIdField.value = '';
    selectedFiles = [];
    filePreviewContainer.innerHTML = '';
    document.getElementById('date').value = new Date().toISOString().split('T')[0];
}

// Set default date
document.getElementById('date').value = new Date().toISOString().split('T')[0];

// Form validation and submission
document.getElementById('donationForm').addEventListener('submit', function(e) {
    const mtkId = hiddenIdField.value;
    const amount = document.getElementById('amount').value;
    const date = document.getElementById('date').value;

    const oldError = document.querySelector('.alert-error');
    if (oldError) oldError.remove();

    let errorMsg = '';

    if (!mtkId || mtkId === '') {
        errorMsg = 'Vui lòng chọn mạnh thường quân.';
    } else if (!amount || parseFloat(amount) <= 0) {
        errorMsg = 'Vui lòng nhập số tiền hợp lệ.';
    } else if (!date) {
        errorMsg = 'Vui lòng chọn ngày ủng hộ.';
    }

    // Kiểm tra các file đã chọn loại minh chứng chưa
    const filesWithoutEvidence = selectedFiles.filter(f => !f.loaiMinhChung);
    if (selectedFiles.length > 0 && filesWithoutEvidence.length > 0) {
        errorMsg = 'Vui lòng chọn loại minh chứng cho tất cả các file đã upload.';
    }

    if (errorMsg) {
        e.preventDefault();
        const alertDiv = document.createElement('div');
        alertDiv.className = 'alert alert-error';
        alertDiv.innerHTML = `<span>${errorMsg}</span>`;
        const buttonGroup = document.querySelector('.button-group');
        buttonGroup.parentNode.insertBefore(alertDiv, buttonGroup);
        setTimeout(() => {
            alertDiv.style.transition = 'opacity 0.5s';
            alertDiv.style.opacity = '0';
            setTimeout(() => alertDiv.remove(), 500);
        }, 5000);
        return false;
    }

    // Thêm hidden fields cho loại minh chứng
    selectedFiles.forEach((item, index) => {
        const hiddenInput = document.createElement('input');
        hiddenInput.type = 'hidden';
        hiddenInput.name = `LoaiMinhChung_${index}`;
        hiddenInput.value = item.loaiMinhChung;
        this.appendChild(hiddenInput);
    });
});

// Auto hide alerts
setTimeout(function () {
    const errorAlert = document.getElementById('alertError');
    const successAlert = document.getElementById('alertSuccess');

    if (errorAlert) {
        errorAlert.style.transition = 'opacity 0.5s';
        errorAlert.style.opacity = '0';
        setTimeout(() => errorAlert.remove(), 500);
    }
    if (successAlert) {
        successAlert.style.transition = 'opacity 0.5s';
        successAlert.style.opacity = '0';
        setTimeout(() => successAlert.remove(), 500);
    }
}, 5000);
</script>