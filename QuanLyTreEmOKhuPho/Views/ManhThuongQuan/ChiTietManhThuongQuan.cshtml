
@{
    ViewBag.Title = "ChiTietManhThuongQuan";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ChiTietManhThuongQuan = ViewBag.ChiTietManhThuongQuan;
    var LichSuUngHo = ViewBag.LichSuUngHo;
    int stt = 1;

}
<link rel="stylesheet" href="~/Content/css/Site.css" />
<link rel="stylesheet" href="~/Content/css/ChiTietManhThuongQuan.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="stats-grid">
    <div class="stat-card primary">
        <div class="stat-label">Tổng số tiền ủng hộ</div>
        <div class="stat-value primary" id="totalDonated">    @String.Format("{0:N2} triệu", ChiTietManhThuongQuan.TongTienUngHo / 1000000)</div>
    </div>
    <div class="stat-card success">
        <div class="stat-label">Số lần ủng hộ</div>
        <div class="stat-value success" id="donationCount">@ChiTietManhThuongQuan.SoLanUngHo lần</div>
    </div>
    <div class="stat-card warning">
        <div class="stat-label">Ủng hộ gần nhất</div>
        <div class="stat-value warning" id="lastDonation">@ChiTietManhThuongQuan.NgayUngHoGanNhat</div>
    </div>
</div>

<!-- Thông tin chi tiết -->
<div class="card">
    <h3 class="card-title">
        <span><i class="fa-solid fa-file"></i></span> Thông tin chi tiết
    </h3>
    <div class="info-grid">
        <div class="info-item">
            <div class="info-label">Tên đầy đủ</div>
            <div class="info-value" id="detailName">@ChiTietManhThuongQuan.Ten</div>
        </div>
        <div class="info-item">
            <div class="info-label">Loại</div>
            <div class="info-value" id="detailType">@ChiTietManhThuongQuan.Loai</div>
        </div>
        <div class="info-item">
            <div class="info-label">Số điện thoại</div>
            <div class="info-value" id="detailPhone">@ChiTietManhThuongQuan.SDT</div>
        </div>
        <div class="info-item">
            <div class="info-label">Email</div>
            <div class="info-value" id="detailEmail">@ChiTietManhThuongQuan.Email</div>
        </div>
        <div class="info-item">
            <div class="info-label">Địa chỉ</div>
            <div class="info-value" id="detailAddress">@ChiTietManhThuongQuan.DiaChi</div>
        </div>
        <div class="info-item">
            <div class="info-label">Ghi chú</div>
            <div class="info-value" id="detailNote">@ChiTietManhThuongQuan.GhiChu</div>
        </div>
    </div>
</div>

<!-- Lịch sử ủng hộ -->
<div class="card">
    <h3 class="card-title">
        <span><i class="fa-regular fa-hourglass"></i></span> Lịch sử ủng hộ
    </h3>

    <div class="filter-bar">
        <select id="filterYear" onchange="filterDonations()">
            <option value="">Tất cả các năm</option>
            <option value="2025" selected>Năm 2025</option>
            <option value="2024">Năm 2024</option>
        </select>
        <select id="filterType" onchange="filterDonations()">
            <option value="">Tất cả loại ủng hộ</option>
            <option value="Tiền mặt">Tiền mặt</option>
            <option value="Chuyển khoản">Chuyển khoản</option>
            <option value="Quà tặng">Quà tặng</option>
        </select>
        <input type="text" id="searchDonation" placeholder="Tìm kiếm ghi chú..." onkeyup="filterDonations()">
    </div>

    <div class="table-container">
        <table id="donationTable">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Ngày ủng hộ</th>
                    <th>Số tiền</th>
                    <th>Loại ủng hộ</th>
                    <th>Ghi chú</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="donationTableBody">
                @foreach (var item in LichSuUngHo)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.NgayUngHo.ToString("dd/MM/yyyy")</td>
                        <td><span class="amount-highlight">  @String.Format("{0:N2} triệu", @item.SoTien / 1000000)</span></td>
                        <td>@item.LoaiUngHo</td>
                        <td>@item.GhiChu</td>
                        <td>
                            <a href="@Url.Action("SuaUngHoManhThuongQuan", "ManhThuongQuan", new { UngHoID = item.UngHoId })"
                               class="btn btn-outline btn-sm">
                                ✏️ Sửa
                            </a>
                            @using (Html.BeginForm("XoaUngHo", "ManhThuongQuan", FormMethod.Post, new { @class = "inline-form" }))
                            {
                                <input type="hidden" name="UngHoId" value="@item.UngHoId" />
                                <input type="hidden" name="ManhThuongQuanId" value="@item.ManhThuongQuanId" />
                                <button type="submit" class="btn btn-outline btn-sm"
                                        style="color: var(--danger);"
                                        onclick="return confirm('Bạn có chắc muốn xóa ủng hộ này không?');">
                                    Xóa
                                </button>
                            }
                        </td>
                    </tr>
                    stt++;
                }


            </tbody>
        </table>
    </div>

    <div id="emptyState" class="empty-state" style="display: none;">
        <div class="empty-state-icon"><i class="fa-regular fa-message"></i></div>
        <p>Chưa có lịch sử ủng hộ</p>
    </div>
</div>

<table id="donationTable">
    <thead>
        <tr>
            <th>STT</th>
            <th>Ngày ủng hộ</th>
            <th>Số tiền</th>
            <th>Loại</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        <!-- Dữ liệu từ API được render vào đây -->
    </tbody>
</table>

<script>
    function filterDonations() {
        const year = document.getElementById('filterYear').value;
        const type = document.getElementById('filterType').value.toLowerCase();
        const searchText = document.getElementById('searchDonation').value.toLowerCase();

        const table = document.getElementById('donationTable');
        const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let row of rows) {
            const dateCell = row.cells[1].innerText; // Ngày ủng hộ
            const typeCell = row.cells[3].innerText.toLowerCase(); // Loại ủng hộ
            const noteCell = row.cells[4].innerText.toLowerCase(); // Ghi chú

            let show = true;

            // Lọc theo năm
            if (year && new Date(dateCell).getFullYear() != parseInt(year)) {
                show = false;
            }

            // Lọc theo loại
            if (type && !typeCell.includes(type)) {
                show = false;
            }

            // Lọc theo ghi chú
            if (searchText && !noteCell.includes(searchText)) {
                show = false;
            }

            row.style.display = show ? '' : 'none';
        }
    }
    function xoaUngHo(ungHoId) {
        // Hiển thị hộp thoại xác nhận
        if (!confirm(" Bạn có chắc chắn muốn xóa ủng hộ này?\n\nHành động này không thể hoàn tác!")) {
            return; // Người dùng chọn "Hủy"
        }

        fetch(`https://localhost:44362/api/ManhThuongQuan/XoaUngHo?UngHoId=${ungHoId}`, {
            method: 'DELETE'
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Không thể xóa ủng hộ');
                }
                return response.json();
            })
            .then(data => {
                alert("Đã xóa thành công);
                location.reload();
            })
            .catch(error => {
                // Thông báo lỗi
                alert("❌ Có lỗi xảy ra: " + error.message);
                console.error('Error:', error);
            });
    }

</script>
