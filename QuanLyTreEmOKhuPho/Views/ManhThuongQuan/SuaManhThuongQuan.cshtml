@using QuanLyTreEmOKhuPho.Models.ManhThuongQuan
@model GhiNhanManhThuongQuan
@{
    ViewBag.Title = "SuaManhThuongQuan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/Site.css" />
<link rel="stylesheet" href="~/Content/css/GhiNhanManhThuongQuan.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="back-button">
    <a href="@Url.Action("ManhThuongQuan", "ManhThuongQuan")" class="btn-back">
        <i class="fa-solid fa-arrow-left"></i> Quay lại
    </a>
</div>
<div class="card">
    <form id="donorForm" method="post" action="@Url.Action("SuaManhThuongQuan","ManhThuongQuan")">

        <!-- Hidden field để truyền ID -->
        <input type="hidden" name="ManhThuongQuanId" value="@Model.ManhThuongQuanId" />

        <!-- Thông tin cơ bản -->
        <div class="form-section">
            <div class="section-title">
                <span><i class="fa-solid fa-file"></i></span>
                Thông tin cơ bản
            </div>

            <div class="form-group">
                <label>
                    Loại mạnh thường quân <span class="required">*</span>
                </label>
                <div class="radio-group">
                    <label class="radio-item @(Model.Loai == "Cá nhân" ? "selected" : "")" onclick="selectType('Cá nhân')">
                        <input type="radio" name="Loai" value="Cá nhân" @(Model.Loai == "Cá nhân" ? "checked" : "") required>
                        <span><i class="fa-regular fa-user"></i> Cá nhân</span>
                    </label>
                    <label class="radio-item @(Model.Loai == "Tổ chức" ? "selected" : "")" onclick="selectType('Tổ chức')">
                        <input type="radio" name="Loai" value="Tổ chức" @(Model.Loai == "Tổ chức" ? "checked" : "")>
                        <span><i class="fa-regular fa-building"></i> Tổ chức</span>
                    </label>
                </div>
                <span class="error-message">Vui lòng chọn loại mạnh thường quân</span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>
                        Tên đầy đủ <span class="required">*</span>
                    </label>
                    <input type="text"
                           id="ten"
                           name="Ten"
                           value="@Model.Ten"
                           placeholder="Nhập tên cá nhân hoặc tổ chức"
                           maxlength="100"
                           required>
                    <span class="error-message">Vui lòng nhập tên</span>
                </div>
                <div class="form-group">
                    <label>
                        Số điện thoại <span class="required">*</span>
                    </label>
                    <input type="tel"
                           id="sdt"
                           name="SDT"
                           value="@Model.SDT"
                           placeholder="0xxx xxx xxx"
                           maxlength="15"
                           pattern="[0-9]{10,15}"
                           title="Chỉ được nhập số từ 0-9, độ dài 10 số"
                           required>
                    <span class="error-message">Vui lòng nhập số điện thoại hợp lệ</span>
                </div>
            </div>
        </div>

        <!-- Thông tin liên hệ -->
        <div class="form-section">
            <div class="section-title">
                <span><i class="fa-solid fa-phone"></i></span>
                Thông tin liên hệ
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           id="email"
                           name="Email"
                           value="@Model.Email"
                           placeholder="email@example.com"
                           maxlength="100">
                    <span class="help-text">Để gửi thông báo và thư cảm ơn</span>
                </div>

                <div class="form-group">
                    <label>Địa chỉ</label>
                    <input type="text"
                           required
                           id="diaChi"
                           name="DiaChi"
                           value="@Model.DiaChi"
                           title="Nhập địa chỉ cá nhân hoặc tổ chức"
                           placeholder="Số nhà, đường, phường, quận/huyện, tỉnh/thành"
                           maxlength="200">
                </div>
            </div>
        </div>

        <!-- Ghi chú -->
        <div class="form-section">
            <div class="section-title">
                <span><i class="fa-solid fa-file"></i></span>
                Thông tin bổ sung
            </div>

            <div class="form-group">
                <label>Ghi chú</label>
                <textarea id="ghiChu"
                          name="GhiChu"
                          placeholder="Thông tin bổ sung, quan hệ, lưu ý đặc biệt..."
                          maxlength="300">@Model.GhiChu</textarea>
                <span class="help-text" id="noteCounter">@(Model.GhiChu?.Length ?? 0)/300 ký tự</span>
            </div>
        </div>

        <!-- Buttons -->
        <div class="form-actions">
            <a href="@Url.Action("ManhThuongQuan", "ManhThuongQuan")" class="btn btn-outline">
                <span><i class="fa-solid fa-xmark"></i></span> Hủy
            </a>
            <button type="submit" class="btn btn-success">
                <span><i class="fa-solid fa-check"></i></span> Lưu thông tin
            </button>
        </div>
    </form>
    @if (ViewBag.MessageError != null)
    {
        <div class="alert alert-error" id="alertError">
            <span>@ViewBag.MessageError</span>
        </div>
    }
    @if (ViewBag.MessageSuccess != null)
    {
        <div class="alert alert-success" id="alertSuccess">
            <span>@ViewBag.MessageSuccess</span>
        </div>
    }
</div>

<script>
    // Initialize character counter on page load
    window.addEventListener('DOMContentLoaded', function () {
        const ghiChuTextarea = document.getElementById('ghiChu');
        const length = ghiChuTextarea.value.length;
        document.getElementById('noteCounter').textContent = `${length}/300 ký tự`;

        // Auto hide alerts after 5 seconds
        const alerts = document.querySelectorAll('.alert');
        if (alerts.length > 0) {
            setTimeout(function () {
                alerts.forEach(alert => {
                    alert.classList.add('fade-out');
                    setTimeout(() => alert.remove(), 500);
                });
            }, 5000);
        }
    });

    // Character counter for note
    document.getElementById('ghiChu').addEventListener('input', function () {
        const length = this.value.length;
        document.getElementById('noteCounter').textContent = `${length}/300 ký tự`;
    });

    function selectType(type) {
        document.querySelectorAll('.radio-item').forEach(item => {
            item.classList.remove('selected');
        });

        event.currentTarget.classList.add('selected');

        const formGroup = document.querySelector('input[name="Loai"]').closest('.form-group');
        formGroup.classList.remove('error');
    }

    function resetForm() {
        if (confirm('Bạn có chắc chắn muốn hủy thay đổi? Các thay đổi chưa lưu sẽ bị mất.')) {
            location.reload();
        }
    }
</script>