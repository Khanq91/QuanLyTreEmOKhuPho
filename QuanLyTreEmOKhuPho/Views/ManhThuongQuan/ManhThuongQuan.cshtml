
@{
    ViewBag.Title = "ManhThuongQuan";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var TongThongKe = ViewBag.TongThongKe;
    var ThongTinManhThuongQuan = ViewBag.ThongTinManhThuongQuan;
    int stt = 1;
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ManhThuongQuan.css" />
<style>
    .header-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 16px;
        background: var(--gray-50);
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), #3b82f6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
    }

    .filter-actions {
        display: flex;
        gap: 10px;
    }
</style>
<div class="stats-grid">
    <div class="stat-card primary">
        <div class="stat-header">
            <div class="stat-title">Tổng mạnh thường quân</div>
            <div class="stat-icon"><i class="fa-solid fa-users-line"></i></div>
        </div>
        <div class="stat-value" id="totalDonors">@TongThongKe.TongSoManhThuongQuan</div>
        <div class="stat-change" id="donorBreakdown">@TongThongKe.SoCaNhan cá nhân, @TongThongKe.SoToChuc tổ chức</div>
    </div>

    <div class="stat-card success">
        <div class="stat-header">
            <div class="stat-title">Tổng tiền ủng hộ</div>
            <div class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></div>
        </div>
        <div class="stat-value" id="totalAmount">
            @FormatMoney(TongThongKe.TongTienUngHo)
        </div>
    </div>

    <div class="stat-card warning">
        <div class="stat-header">
            <div class="stat-title">Ủng hộ tháng này</div>
            <div class="stat-icon"><i class="fa-solid fa-calendar-days"></i></div>
        </div>
        <div class="stat-value" id="totalAmount">
            @FormatMoney(TongThongKe.TongTienUngHoThangNay)
        </div>
    </div>

    <div class="stat-card danger">
        <div class="stat-header">
            <div class="stat-title">Nhà tài trợ thường xuyên</div>
            <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
        </div>
        <div class="stat-value" id="regularDonors">@TongThongKe.TongNhaTaiTroThuongXuyen</div>
        <div class="stat-change">Ủng hộ hơn 3 lần/năm</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách mạnh thường quân</h3>
        <div style="display: flex; gap: 10px;">
            @using (Html.BeginForm("GhiNhanUngHo", "ManhThuongQuan", FormMethod.Post, new { @class = "form-ung-ho" }))
            {
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-circle-plus"></i> Ghi nhận ủng hộ
                </button>
            }
            @using (Html.BeginForm("GhiNhanManhThuongQuan", "ManhThuongQuan", FormMethod.Post, new { @class = "form-manh-ho" }))
            {
                <button class="btn btn-primary">
                    <i class="fa-solid fa-circle-plus"></i> Thêm mạnh thường quân
                </button>

            }
        </div>
    </div>
    <div class="filter-group">
        <div class="filter-item">
            <label>Loại</label>
            <select id="filterType" onchange="filterTable()">
                <option value="">Tất cả</option>
                <option value="Cá nhân">Cá nhân</option>
                <option value="Tổ chức">Tổ chức</option>
            </select>
        </div>
        <div class="filter-item">
            <label>Sắp xếp</label>
            <select id="filterSort" onchange="filterTable()">
                <option value="name">Tên A-Z</option>
                <option value="amountAsc">Số tiền tăng dần</option>
                <option value="amountDesc">Số tiền giảm dần</option>
            </select>

        </div>
        <div class="filter-item">
            <label>Tìm kiếm</label>
            <input type="text" id="searchInput" placeholder="Tên, SĐT, Email..." onkeyup="filterTable()">
        </div>
        <div class="filter-actions" style="padding-top:24px; ">
            <button type="button" class="btn btn-secondary " style="max-height:30px" onclick="resetFilters()">Đặt lại</button>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên</th>
                    <th>Loại</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th>Tổng ủng hộ</th>
                    <th>Số lần</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var item in ThongTinManhThuongQuan)
                {
                    <tr>
                        <td>@stt </td>
                        <td>@item.Ten</td>
                        <td>@item.Loai</td>
                        <td>@item.SDT</td>
                        <td>@item.Email</td>
                        <td>@item.DiaChi</td>
                        <td>
                            <strong>
                                @FormatMoney(item.TongUngHo)
                            </strong>
                        </td>
                        <td>@item.SoLanUngHo lần</td>
                        <td>
                            @using (Html.BeginForm("ChiTietManhThuongQuan", "ManhThuongQuan", new { ManhThuongQuanId = item.ManhThuongQuanId }))
                            {
                                <button class="btn btn-primary btn-sm">Chi tiết</button>
                            }
                            <a href="@Url.Action("SuaManhThuongQuan", "ManhThuongQuan", new { ManhThuongQuanId = item.ManhThuongQuanId })"
                               class="btn btn-outline btn-sm">
                                Sửa
                            </a>

                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>
    </div>
</div>
<script>
    // Lưu trữ dữ liệu gốc khi trang load
    var originalRows = [];

    window.onload = function () {
        var table = document.getElementById("tableBody");
        originalRows = Array.from(table.getElementsByTagName("tr")).map(row => row.cloneNode(true));
    };

    function filterTable() {
        var typeFilter = document.getElementById("filterType").value.trim();
        var sortFilter = document.getElementById("filterSort").value;
        var searchInput = document.getElementById("searchInput").value.toLowerCase().trim();

        // Sử dụng dữ liệu gốc để filter
        var filteredRows = originalRows.filter(row => {
            var cells = row.getElementsByTagName("td");
            var ten = cells[1].innerText.toLowerCase().trim();
            var loai = cells[2].innerText.trim();
            var sdt = cells[3].innerText.toLowerCase().trim();
            var email = cells[4].innerText.toLowerCase().trim();

            var typeMatch = typeFilter === "" || loai === typeFilter;
            var searchMatch = searchInput === "" || ten.includes(searchInput) || sdt.includes(searchInput) || email.includes(searchInput);

            return typeMatch && searchMatch;
        });

        // Sắp xếp
        filteredRows.sort((a, b) => {
            var cellsA = a.getElementsByTagName("td");
            var cellsB = b.getElementsByTagName("td");

            if (sortFilter === "name") {
                return cellsA[1].innerText.localeCompare(cellsB[1].innerText);
            }
            else if (sortFilter === "amountAsc") {
                var amountA = parseFloat(cellsA[6].innerText.replace(/[^\d.-]/g, '')) || 0;
                var amountB = parseFloat(cellsB[6].innerText.replace(/[^\d.-]/g, '')) || 0;
                return amountA - amountB;
            }
            else if (sortFilter === "amountDesc") {
                var amountA = parseFloat(cellsA[6].innerText.replace(/[^\d.-]/g, '')) || 0;
                var amountB = parseFloat(cellsB[6].innerText.replace(/[^\d.-]/g, '')) || 0;
                return amountB - amountA;
            }
            return 0;
        });

        // Hiển thị lại dữ liệu đã filter
        var table = document.getElementById("tableBody");
        table.innerHTML = "";
        filteredRows.forEach(row => table.appendChild(row.cloneNode(true)));
    }

    function resetFilters() {
        document.getElementById("filterType").value = "";
        document.getElementById("filterSort").value = "name";
        document.getElementById("searchInput").value = "";
        filterTable();
    }
</script>
@functions {
    string FormatMoney(decimal amount)
    {
        if (amount >= 1_000_000_000) // >= 1 tỷ
            return string.Format("{0:N2} tỉ", amount / 1_000_000_000M);
        else if (amount >= 1_000_000) // >= 1 triệu
            return string.Format("{0:N2} triệu", amount / 1_000_000M);
        else if (amount >= 1_000) // >= 1 nghìn
            return string.Format("{0:N0} nghìn", amount / 1_000M);
        else
            return string.Format("{0:N0}", amount); // <1 nghìn
    }
}