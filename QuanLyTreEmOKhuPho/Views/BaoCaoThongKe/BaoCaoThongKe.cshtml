@{
    ViewBag.Title = "Báo cáo & Thống kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/css/BaoCaoThongKe.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Content/css/media.css" asp-append-version="true" />

<div class="stats-grid">
    <div class="stat-card primary">
        <div class="stat-header">
            <div class="stat-title">Tổng số sự kiện</div>
            <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
        </div>
        <div class="stat-value" id="soSuKien">0</div>
        <div class="stat-change up">
            <span id="suKienChange">↑ 0%</span>
            <span style="color: var(--gray-600);">so với tháng trước</span>
        </div>
    </div>
    <div class="stat-card success">
        <div class="stat-header">
            <div class="stat-title">Trẻ được hỗ trợ</div>
            <div class="stat-icon"><i class="fa-solid fa-children"></i></div>
        </div>
        <div class="stat-value" id="soTreHoTro">0</div>
        <div class="stat-change up">
            <span id="treHoTroChange">↑ 0%</span>
            <span style="color: var(--gray-600);">so với tháng trước</span>
        </div>
    </div>
    <div class="stat-card warning">
        <div class="stat-header">
            <div class="stat-title">Tổng tiền ủng hộ</div>
            <div class="stat-icon"><i class="fa-solid fa-sack-dollar"></i></div>
        </div>
        <div class="stat-value" id="tongUngHo">0M</div>
        <div class="stat-change up">
            <span id="ungHoChange">↑ 0%</span>
            <span style="color: var(--gray-600);">so với tháng trước</span>
        </div>
    </div>
    <div class="stat-card purple">
        <div class="stat-header">
            <div class="stat-title">Tình nguyện viên</div>
            <div class="stat-icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
        </div>
        <div class="stat-value" id="soTinhNguyenVien">0</div>
        <div class="stat-change up">
            <span id="tnvChange">↑ 0%</span>
            <span style="color: var(--gray-600);">so với tháng trước</span>
        </div>
    </div>
</div>

<div class="chart-grid">
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">Sự kiện theo tháng</h3>
        </div>
        <div class="chart-container">
            <canvas id="eventsChart"></canvas>
        </div>
    </div>
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">Trẻ em được hỗ trợ</h3>
        </div>
        <div class="chart-container">
            <canvas id="childrenChart"></canvas>
        </div>
    </div>
    <div class="chart-card">
        <div class="chart-header">
            <h3 class="chart-title">Nguồn ủng hộ</h3>
        </div>
        <div class="chart-container">
            <canvas id="donationsChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/Scripts/BaoCaoThongKe.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Tải tất cả dữ liệu song song
            $.when(
                loadTongQuan(),
                loadTreEmTheoThang(),
                loadNguonUngHo()
            ).fail(function () {
                console.error("Lỗi khi tải dữ liệu báo cáo");
                alert("Đã có lỗi xảy ra khi tải dữ liệu. Vui lòng thử lại sau.");
            });
        });

        function loadTongQuan() {
            return $.ajax({
                url: 'https://localhost:44362/api/BaoCaoThongKe/TongQuan',
                method: 'GET',
                dataType: 'json',
                success: function (data) {
                    debugger
                    $('#soSuKien').text(data.soSuKien || 0);
                    $('#soTreHoTro').text(data.soTreDuocHoTro || 0);
                    $('#tongUngHo').text((data.tongUngHo ? (data.tongUngHo / 1000000).toFixed(1) : 0) + 'M');
                    $('#soTinhNguyenVien').text(data.soTinhNguyenVien || 0);

                    // Tạm thời để mặc định phần trăm thay đổi
                    $('#suKienChange').text('↑ 0%');
                    $('#treHoTroChange').text('↑ 0%');
                    $('#ungHoChange').text('↑ 0%');
                    $('#tnvChange').text('↑ 0%');
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi loadTongQuan:', error, xhr.status);
                    throw new Error('Lỗi loadTongQuan');
                }
            });
        }


        function loadTreEmTheoThang() {
            return $.ajax({
                url: 'https://localhost:44362/api/BaoCaoThongKe/TreHoTroTheoKy?',
                method: 'GET',
                dataType: 'json',
                success: function (data) {
                    const labels = data.map(item => item.label || 'Tháng không xác định');
                    const values = data.map(item => item.countTreDistinct || 0);

                    new Chart(document.getElementById('childrenChart'), {
                        type: 'line',
                        data: {
                            labels,
                            datasets: [{
                                label: 'Trẻ được hỗ trợ',
                                data: values,
                                borderColor: 'rgba(255, 99, 132, 1)',
                                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                                fill: true,
                                tension: 0.4
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi loadTreEmTheoThang:', error, xhr.status);
                    throw new Error('Lỗi loadTreEmTheoThang');
                }
            });
        }

        function loadNguonUngHo() {
            return $.ajax({
                url: 'https://localhost:44362/api/BaoCaoThongKe/UngHoTheoLoai',
                method: 'GET',
                dataType: 'json',
                success: function (data) {
                    const labels = data.map(item => item.loaiUngHo || 'Không xác định');
                    const values = data.map(item => item.tongSoTien || 0);

                    new Chart(document.getElementById('donationsChart'), {
                        type: 'pie',
                        data: {
                            labels,
                            datasets: [{
                                label: 'Ủng hộ theo loại',
                                data: values,
                                backgroundColor: [
                                    '#4CAF50',
                                    '#FFC107',
                                    '#FF5722',
                                    '#03A9F4',
                                    '#9C27B0',
                                    '#009688'
                                ],
                                hoverOffset: 20
                            }]
                        },
                        options: {
                            responsive: true,
                            plugins: {
                                legend: {
                                    position: 'bottom'
                                }
                            }
                        }
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Lỗi loadNguonUngHo:', error, xhr.status);
                    throw new Error('Lỗi loadNguonUngHo');
                }
            });
        }
    </script>
}