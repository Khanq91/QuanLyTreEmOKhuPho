            <button type="button" class="btn btn-primary" id="submitAddChildBtn" onclick="submitAddChildForm()">
                <i class="fa-solid fa-check"></i>
                Xác Nhận Thêm
            </button>
        </div>
    </div>
</div>

<script>
    function openEvidenceModal() {
        document.getElementById('evidenceModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeEvidenceModal() {
        document.getElementById('evidenceModal').classList.remove('active');
        document.body.style.overflow = 'auto';
    }

    function previewFile(id, filePath, fileName, isImage) {
        const modal = document.getElementById('previewModal');
        const previewBody = document.getElementById('previewBody');
        const previewTitle = document.getElementById('previewTitle');

        previewTitle.innerHTML = `<i class="fa-solid fa-eye"></i><span style="margin-left: 8px;">${fileName}</span>`;
        modal.classList.add('active');

        const extension = filePath.split('.').pop().toLowerCase();

        if (isImage) {
            previewBody.innerHTML = `<img src="${filePath}" alt="${fileName}" style="max-width: 100%; max-height: 100%; object-fit: contain;">`;
        } else if (extension === 'pdf') {
            previewBody.innerHTML = `<iframe src="${filePath}" style="width: 100%; height: 100%; border: none;"></iframe>`;
        } else if (['doc', 'docx', 'xls', 'xlsx'].includes(extension)) {
            // Sử dụng Google Docs Viewer hoặc Office Online
            const encodedUrl = encodeURIComponent(window.location.origin + filePath);
            previewBody.innerHTML = `<iframe src="https://view.officeapps.live.com/op/embed.aspx?src=${encodedUrl}" style="width: 100%; height: 100%; border: none;"></iframe>`;
        } else {
            previewBody.innerHTML = `
                                                                            <div style="text-align: center; padding: 40px;">
                                                                                <i class="fa-solid fa-file" style="font-size: 80px; color: #667eea; margin-bottom: 20px;"></i>
                                                                                <p style="color: #6c757d; font-size: 16px;">Không thể xem trước loại file này</p>
                                                                                <button class="download-btn" onclick="downloadFile('${filePath}', '${fileName}')" style="max-width: 300px; margin: 20px auto;">
                                                                                    <i class="fa-solid fa-download"></i>
                                                                                    Tải xuống để xem
                                                                                </button>
                                                                            </div>
                                                                        `;
        }
    }

    function closePreviewModal() {
        document.getElementById('previewModal').classList.remove('active');
    }

    function downloadFile(filePath, fileName) {
        // Tạo link download
        const link = document.createElement('a');
        link.href = filePath;
        link.download = fileName || 'download';
        link.target = '_blank';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // Đóng modal khi click bên ngoài
    document.getElementById('evidenceModal').addEventListener('click', function (e) {
        if (e.target === this) {
            closeEvidenceModal();
        }
    });

    document.getElementById('previewModal').addEventListener('click', function (e) {
        if (e.target === this) {
            closePreviewModal();
        }
    });

    // Đóng modal bằng phím ESC
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeEvidenceModal();
            closePreviewModal();
        }
    });
</script>
