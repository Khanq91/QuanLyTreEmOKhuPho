<div class="detail-container">
    <h3 class="section-title">
        <i class="fa-solid fa-gift"></i>
        Danh Sách Quà Tặng
    </h3>
    <!-- Lặp qua từng quà tặng -->
    @foreach (var qua in ChiTietUngHo.DanhSachQuaTang)
    {
        <!-- Tính thống kê riêng cho quà tặng này -->
        var tongSoLuong = qua.DanhSachTreNhan.Count;
        var daPhat = ((IEnumerable<dynamic>)qua.DanhSachTreNhan).Count(t => t.TrangThai == "Đã nhận");
        var conLai = tongSoLuong - daPhat;
        var percentDaPhat = tongSoLuong > 0 ? (int)((double)daPhat / tongSoLuong * 100) : 0;

        <div class="gift-card">
            <div class="gift-header">
                <div style="display: flex; align-items: start;">
                    <div class="gift-image">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>
                    <div class="gift-info">
                        <div class="gift-name">@qua.TenQua</div>
                        <p class="gift-desc">@qua.MoTa</p>
                    </div>
                </div>
                @*<div class="gift-price">
                        <div class="price-label">Đơn giá</div>
                        <div class="price-value">@qua.DonGia.ToString("N0") VNĐ</div>
                    </div>*@
            </div>

            <!-- Thống kê riêng của quà này -->
            <div class="gift-stats">
                <div class="stat-box">
                    <div class="stat-label">Tổng số lượng</div>
                    <div class="stat-value">@tongSoLuong</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Đã phát</div>
                    <div class="stat-value">@daPhat</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Còn lại</div>
                    <div class="stat-value">@conLai</div>
                </div>
            </div>

            <div class="progress-bar">
                <div class="progress-fill" style="width:@percentDaPhat%;"></div>
            </div>
            <div class="progress-text">Đã phát: @percentDaPhat%</div>
            <!-- Bảng trẻ nhận quà CỦA QUÀ NÀY -->
            <table class="recipients-table">
                <thead>
                    <tr>
                        <th>Tên trẻ</th>
                        <th>Ngày sinh</th>
                        <th>Khu phố</th>
                        <th>Số lượng</th>
                        <th>Ngày nhận</th>
                        <th>Người phát</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- CHỈ lặp qua trẻ em của quà này -->
                    @foreach (var tre in qua.DanhSachTreNhan)
                    {
                        <tr>
                            <td>
                                <div class="student-info">
                                    <div>
                                        <div class="student-name">@tre.HoTen</div>
                                        <div class="student-status">@tre.TinhTrang</div>
                                    </div>
                                </div>
                            </td>
                            <td>@tre.NgaySinh.ToString("dd/MM/yyyy")</td>
                            <td>@tre.TenKhuPho</td>
                            <td style="font-weight: 600;">@tre.SoLuongNhan</td>
                            <td>@tre.NgayPhanPhat.ToString("dd/MM/yyyy")</td>
                            <td>@tre.NguoiPhanPhat</td>
                            <td>
                                @if (tre.TrangThai == "Đã nhận")
                                {
                                    <span class="status-badge status-received">
                                        <i class="fa-solid fa-circle-check"></i> Đã nhận
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        <i class="fa-solid fa-clock"></i> @tre.TrangThai
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @if (tre.TrangThai == "Đã nhận")
                                    {
                                        using (Html.BeginForm("SuaTrangThai", "HoTroVaUngHo", FormMethod.Post, new { @class = "inline-form" }))
                                        {
                                            <input type="hidden" name="UngHoID" value="@ChiTietUngHo.UngHoID" />
                                            <input type="hidden" name="id" value="@tre.PhanPhatID" />
                                            <input type="hidden" name="TrangThai" value="Chưa phát" />
                                            <button class="btn btn-sm btn-warning"
                                                    data-tooltip="Đánh dấu chưa nhận quà">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        using (Html.BeginForm("SuaTrangThai", "HoTroVaUngHo", FormMethod.Post, new { @class = "inline-form" }))
                                        {
                                            <input type="hidden" name="UngHoID" value="@ChiTietUngHo.UngHoID" />
                                            <input type="hidden" name="id" value="@tre.PhanPhatID" />
                                            <input type="hidden" name="TrangThai" value="Đã nhận" />
                                            <button class="btn btn-sm btn-success"
                                                    data-tooltip="Đánh dấu đã nhận quà">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        }

                                    }
                                    @using (Html.BeginForm("XoaHoTro", "HoTroVaUngHo", FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        <input type="hidden" name="id" value="@tre.PhanPhatID" />
                                        <input type="hidden" name="UngHoID" value="@ChiTietUngHo.UngHoID" />

                                        <button class="btn btn-sm btn-delete"
                                                data-tooltip="Xóa trẻ em khỏi danh sách">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

<!-- Thay thế phần Minh chứng & Tài Liệu cũ bằng đoạn này -->
<div class="detail-container">
    <h3 class="section-title">
        <i class="fa-solid fa-paperclip"></i>
        Minh Chứng & Tài Liệu
    </h3>

    <div class="evidence-grid">
        <div class="evidence-card" onclick="openEvidenceModal()" style="cursor: pointer;">
            <div class="evidence-icon">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div class="evidence-name">Xem tất cả minh chứng</div>
            <div class="evidence-date">
                @if (ChiTietUngHo.DanhSachMinhChung != null && ChiTietUngHo.DanhSachMinhChung.Count > 0)
                {
                    <span>@ChiTietUngHo.DanhSachMinhChung.Count tài liệu</span>
                }
                else
                {
                    <span>4 tài liệu mẫu</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal xem danh sách minh chứng -->
<div id="evidenceModal" class="evidence-modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>
                <i class="fa-solid fa-folder-open"></i>
                <span>Danh Sách Minh Chứng</span>
            </h3>
            <button class="modal-close" onclick="closeEvidenceModal()">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="files-grid" id="filesGrid">
                @if (ChiTietUngHo.DanhSachMinhChung != null && ChiTietUngHo.DanhSachMinhChung.Count > 0)
                {
                    foreach (var minhChung in ChiTietUngHo.DanhSachMinhChung)
                    {
                        var extension = System.IO.Path.GetExtension(minhChung.FilePath).ToLower();
                        var isImage = extension == ".jpg" || extension == ".jpeg" || extension == ".png" || extension == ".gif" || extension == ".bmp";
                        var isPdf = extension == ".pdf";
                        var isWord = extension == ".doc" || extension == ".docx";
                        var isExcel = extension == ".xls" || extension == ".xlsx";

                        var iconClass = isPdf ? "fa-file-pdf pdf-icon" :
                                       isWord ? "fa-file-word word-icon" :
                                       isExcel ? "fa-file-excel excel-icon" :
                                       isImage ? "fa-image image-icon" : "fa-file";

                        var badgeClass = isPdf ? "badge-pdf" :
                                        isWord ? "badge-word" :
                                        isExcel ? "badge-excel" :
                                        isImage ? "badge-image" : "";

                        var fileTypeName = isPdf ? "PDF" :
                                          isWord ? "WORD" :
                                          isExcel ? "EXCEL" :
                                          isImage ? "IMAGE" : "FILE";

                        var fullPath = "https://localhost:44362" + minhChung.FilePath;

                        <div class="file-item" onclick='previewFile(@minhChung.MinhChungID, "@fullPath", "@minhChung.LoaiMinhChung", @isImage.ToString().ToLower())'>
                            <div class="file-preview">
                                @if (isImage)
                                {
                                    <img src="@fullPath" alt="@minhChung.LoaiMinhChung" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fa-solid @iconClass\'></i>';">
                                }
                                else
                                {
                                    <i class="fa-solid @iconClass file-icon"></i>
                                }
                            </div>
                            <div class="file-info">
                                <div class="file-name">@minhChung.LoaiMinhChung</div>
                                <div class="file-meta">
                                    <div class="file-date">
                                        <i class="fa-solid fa-calendar"></i>
                                        @minhChung.NgayCap.ToString("dd/MM/yyyy")
                                    </div>
                                    <span class="file-type-badge @badgeClass">@fileTypeName</span>
                                </div>
                            </div>
                            <button class="download-btn" onclick="event.stopPropagation(); downloadFile('@fullPath', '@minhChung.LoaiMinhChung')">
                                <i class="fa-solid fa-download"></i>
                                Tải xuống
                            </button>
                        </div>
                    }
                }
                else
                {
                    @:<!-- Dữ liệu mẫu -->
                    <div class="file-item" onclick="previewFile(1, 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf', 'Biên nhận học phí học kỳ 1', false)">
                        <div class="file-preview">
                            <i class="fa-solid fa-file-pdf pdf-icon file-icon"></i>
                        </div>
                        <div class="file-info">
                            <div class="file-name">Biên nhận học phí học kỳ 1</div>
                            <div class="file-meta">
                                <div class="file-date">
                                    <i class="fa-solid fa-calendar"></i>
                                    25/01/2025
                                </div>
                                <span class="file-type-badge badge-pdf">PDF</span>
                            </div>
                        </div>
                        <button class="download-btn" onclick="event.stopPropagation(); downloadFile('https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf', 'Biên nhận học phí học kỳ 1.pdf')">
                            <i class="fa-solid fa-download"></i>
                            Tải xuống
                        </button>
                    </div>

                    <div class="file-item" onclick="alert('File Word - Cần có đường dẫn file thực tế')">
                        <div class="file-preview">
                            <i class="fa-solid fa-file-word word-icon file-icon"></i>
                        </div>
                        <div class="file-info">
                            <div class="file-name">Xác nhận chuyển khoản ngân hàng</div>
                            <div class="file-meta">
                                <div class="file-date">
                                    <i class="fa-solid fa-calendar"></i>
                                    20/02/2025
                                </div>
                                <span class="file-type-badge badge-word">WORD</span>
                            </div>
                        </div>
                        <button class="download-btn" onclick="event.stopPropagation(); alert('Cần có file thực tế để download')">
                            <i class="fa-solid fa-download"></i>
                            Tải xuống
                        </button>
                    </div>

                    <div class="file-item" onclick="previewFile(3, 'https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800', 'Ảnh hoạt động phát quà trung thu', true)">
                        <div class="file-preview">
                            <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800" alt="Ảnh phát quà">
                        </div>
                        <div class="file-info">
                            <div class="file-name">Ảnh hoạt động phát quà trung thu</div>
                            <div class="file-meta">
                                <div class="file-date">
                                    <i class="fa-solid fa-calendar"></i>
                                    10/09/2025
                                </div>
                                <span class="file-type-badge badge-image">IMAGE</span>
                            </div>
                        </div>
                        <button class="download-btn" onclick="event.stopPropagation(); downloadFile('https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800', 'Anh_phat_qua.jpg')">
                            <i class="fa-solid fa-download"></i>
                            Tải xuống
                        </button>
                    </div>

                    <div class="file-item" onclick="alert('File Excel - Cần có đường dẫn file thực tế')">
                        <div class="file-preview">
                            <i class="fa-solid fa-file-excel excel-icon file-icon"></i>
                        </div>
                        <div class="file-info">
                            <div class="file-name">Danh sách trẻ em nhận quà chi tiết</div>
                            <div class="file-meta">
                                <div class="file-date">
                                    <i class="fa-solid fa-calendar"></i>
                                    10/09/2025
                                </div>
                                <span class="file-type-badge badge-excel">EXCEL</span>
                            </div>
                        </div>
                        <button class="download-btn" onclick="event.stopPropagation(); alert('Cần có file thực tế để download')">
                            <i class="fa-solid fa-download"></i>
                            Tải xuống
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

