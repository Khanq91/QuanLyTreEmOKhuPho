        </div>
        <div class="info-item">
            <div class="info-label"><i class="fa-solid fa-users"></i> Đối tượng</div>
            <div class="info-value">Trẻ em khó khăn</div>
        </div>
        <div class="info-item">
            <div class="info-label"><i class="fa-solid fa-children"></i> Số trẻ được hỗ trợ</div>
            <div class="info-value">@ChiTietUngHo.SoLuongTreEmDuocUngHo trẻ</div>
        </div>
    </div>

