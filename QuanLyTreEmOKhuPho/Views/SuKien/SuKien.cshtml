@{
    ViewBag.Title = "SuKien";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/SuKien.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/css/media.css" />
<a href="@Url.Action("CreateSuKien", "SuKien")" class="btn btn-primary">
    Tạo sự kiện mới
</a>
<a href="@Url.Action("DangKySuKien", "SuKien")" class="btn btn-primary">
    Đăng ký sự kiện
</a>
<button class="btn btn-warning" onclick="openDangKyModal()">
    Quản lý đăng ký sự kiện
</button>
<div class="filter-tabs">
    <button class="filter-tab active" onclick="filterEvents('all')">
        <i class="fa-solid fa-bars"></i> Tất cả
    </button>
    <button class="filter-tab" onclick="filterEvents('upcoming')">
        <i class="fa-solid fa-calendar-days"></i> Sắp diễn ra
    </button>
    <button class="filter-tab" onclick="filterEvents('ongoing')">
        <i class="fa-solid fa-hourglass-half"></i> Đang diễn ra
    </button>
    <button class="filter-tab" onclick="filterEvents('completed')">
        <i class="fa-solid fa-circle-check"></i> Đã kết thúc
    </button>
</div>

<div class="events-grid" id="eventsGrid"></div>

<script>
    let eventsData = [];

    // 🔹 Gọi dữ liệu từ API backend thật
    async function loadEvents() {
        try {
            const response = await fetch('/SuKien/GetAll');
            const data = await response.json();

            if (data.error) {
                showNotification(data.message, "danger");
                return;
            }

            eventsData = data;
            renderEvents(); // render mặc định tất cả
        } catch (error) {
            console.error(error);
            showNotification("Không thể kết nối đến API sự kiện!", "danger");
        }
    }


    // 🔹 Render danh sách sự kiện
    function renderEvents(filter = 'all') {
        const grid = document.getElementById('eventsGrid');
        grid.innerHTML = '';

        const filtered = filter === 'all'
            ? eventsData
            : eventsData.filter(e => {
                const status = e.trangThai?.toLowerCase();
                return filter === 'upcoming' && status.includes('sắp')
                    || filter === 'ongoing' && status.includes('đang')
                    || filter === 'completed' && status.includes('kết thúc');
            });

        if (filtered.length === 0) {
            grid.innerHTML = `<p style="text-align:center;color:gray;">Không có sự kiện nào.</p>`;
            return;
        }

        filtered.forEach(event => {
            debugger
            const statusClass = getStatusClass(event.trangThai);
            const card = document.createElement('div');
            card.className = 'event-card';
            card.onclick = () => viewEvent(event.SuKienId);

            card.innerHTML = `
                <div class="event-image">
                    <span style="font-size: 80px;">🎉</span>
                </div>
                <div class="event-content">
                    <h3 class="event-title">${event.TenSuKien}</h3>
                    <div class="event-meta">
                        <div class="meta-item">
                            <span class="meta-icon">📅</span>
                            <span>${new Date(parseInt(event.NgayBatDau.replace(/[^0-9]/g, ''))).toLocaleString('vi-VN')} - ${new Date(parseInt(event.NgayKetThuc.replace(/[^0-9]/g, ''))).toLocaleString('vi-VN')}</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-icon">📍</span>
                            <span>${event.DiaDiem}</span>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-sm btn-view" data-id="${event.SuKienId}">👁️ Xem chi tiết</button>
                        <button class="btn btn-sm btn-edit" onclick="event.stopPropagation(); editEvent(${event.SuKienId})">✏️ Sửa</button>
                    </div>
                </div>
            `;

            grid.appendChild(card);
        });
    }

    // 🔹 CSS trạng thái
    function getStatusClass(status) {
        if (!status) return '';
        status = status.toLowerCase();
        if (status.includes('sắp')) return 'status-upcoming';
        if (status.includes('đang')) return 'status-ongoing';
        if (status.includes('kết thúc')) return 'status-completed';
        return '';
    }

    // 🔹 Chuyển định dạng ngày
    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN');
    }

    // 🔹 Lọc
    function filterEvents(status) {
        const tabs = document.querySelectorAll('.filter-tab');
        tabs.forEach(tab => tab.classList.remove('active'));
        event.target.classList.add('active');
        renderEvents(status);
    }

    // 🔹 Giả lập các hành động
    function viewEvent(id) {
        showNotification(`Xem chi tiết sự kiện #${id}`, 'info');
    }

    function editEvent(id) {
        showNotification(`Chỉnh sửa sự kiện #${id}`, 'info');
    }

    function openCreateEventModal() {
        showNotification('Mở form tạo sự kiện mới', 'info');
    }

    // 🔹 Hiển thị thông báo
    function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        const icons = { success: '✓', warning: '⚠', info: 'ℹ', danger: '✕' };
        const colors = {
            success: '#4caf50',
            warning: '#ff9800',
            info: '#2196f3',
            danger: '#f44336'
        };

        notification.innerHTML = `
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 20px;">${icons[type]}</span>
                <span>${message}</span>
            </div>
        `;
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            padding: 16px 24px;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            z-index: 10001;
            animation: slideIn 0.3s ease;
            border-left: 4px solid ${colors[type]};
        `;
        document.body.appendChild(notification);
        setTimeout(() => { notification.remove(); }, 3000);
    }
    document.addEventListener('click', e => {
        const btn = e.target.closest('.btn-view');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        if (id) {
            window.location.href = `/SuKien/ChiTiet/${id}`;
        }
    });
    // 🔹 Khởi chạy khi load trang
    document.addEventListener("DOMContentLoaded", loadEvents);
</script>
<div id="dangKyModal" class="modal fade" tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">📋 Quản lý đăng ký sự kiện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sự kiện</th>
                            <th>Người đăng ký</th>
                            <th>Ngày đăng ký</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="tableDangKy">
                        <tr><td colspan="6" class="text-center text-muted">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<style>
    .modal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
    }
</style>
<script>

    // Mở modal
    function openDangKyModal() {
        const modal = new bootstrap.Modal(document.getElementById("dangKyModal"));
        modal.show();
        loadDangKySuKien();
    }

    // Load danh sách đăng ký từ API
    async function loadDangKySuKien() {
        const tbody = document.getElementById("tableDangKy");
        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">⏳ Đang tải...</td></tr>`;

        try {
            const res = await fetch('https://localhost:44362/api/SuKien/getalldangkysukien');
            if (!res.ok) throw new Error("Không thể tải danh sách");
            const data = await res.json();

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Không có đăng ký nào.</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            data.forEach((item, idx) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                <td>${idx + 1}</td>
                <td>${item.tenSuKien}</td>
                <td>${item.hoTenNguoiDung}</td>
                <td>${item.ngayDangKy}</td>
                <td>
                    <span class="badge ${getBadgeClass(item.trangThai)}">${item.trangThai}</span>
                </td>
                <td class="text-center">
                    <button class="btn btn-success btn-sm me-1" onclick="approveDangKy(${item.dangKySuKienId})">Duyệt</button>
                    <button class="btn btn-danger btn-sm me-1" onclick="rejectDangKy(${item.dangKySuKienId})">Từ chối</button>
                    <button class="btn btn-secondary btn-sm" onclick="deleteDangKy(${item.dangKySuKienId})">Xóa</button>
                </td>
            `;
                tbody.appendChild(row);
            });
        } catch (err) {
            console.error(err);
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">❌ Lỗi tải dữ liệu</td></tr>`;
        }
    }

    // Badge màu trạng thái
    function getBadgeClass(status) {
        status = status?.toLowerCase();
        if (status.includes('chờ')) return 'bg-warning text-dark';
        if (status.includes('đã duyệt')) return 'bg-success';
        if (status.includes('từ chối')) return 'bg-danger';
        return 'bg-secondary';
    }

    // Action: Duyệt
    async function approveDangKy(id) {
        if (!confirm("Xác nhận duyệt đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/approve/${id}`, { method: 'PUT' });
        if (res.ok) {
            showNotification("✅ Đã duyệt đăng ký!", "success");
            loadDangKySuKien();
        } else showNotification("Lỗi duyệt đăng ký!", "danger");
    }

    // Action: Từ chối
    async function rejectDangKy(id) {
        if (!confirm("Bạn có chắc muốn từ chối đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/reject/${id}`, { method: 'PUT' });
        if (res.ok) {
            showNotification("❌ Đã từ chối đăng ký!", "warning");
            loadDangKySuKien();
        } else showNotification("Lỗi từ chối!", "danger");
    }

    // Action: Xóa
    async function deleteDangKy(id) {
        if (!confirm("Bạn có chắc muốn xóa đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/deletedangky/${id}`, { method: 'DELETE' });
        if (res.ok) {
            showNotification("🗑️ Đã xóa đăng ký!", "success");
            loadDangKySuKien();
        } else showNotification("Lỗi xóa đăng ký!", "danger");
    }

</script>
@section scripts {
    <!-- ✅ Thêm dòng này để có bootstrap.Modal -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}