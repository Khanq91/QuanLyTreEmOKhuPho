@{
    ViewBag.Title = "SuKien";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/SuKien.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/css/media.css" />

<style>
    .btn-approve {
        background: #4CAF50;
        border: none;
        color: white;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-approve:hover {
            background: #43a047;
        }

    .btn-reject {
        background: #e53935;
        border: none;
        color: white;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-reject:hover {
            background: #d32f2f;
        }

    .btn-delete {
        background: #757575;
        border: none;
        color: white;
        padding: 5px 12px;
        border-radius: 6px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #616161;
        }

    :root {
        --primary: #4361ee;
        --primary-hover: #3b5bcc;
        --warning: #f39c12;
        --bg-light: #f6f8fc;
        --text-dark: #222;
        --radius: 10px;
        --shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

    body {
        background: var(--bg-light);
        font-family: "Segoe UI", sans-serif;
    }

    /* Thanh hành động */
    .action-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 25px;
    }

        .action-bar a,
        .action-bar button {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            font-size: 15px;
        }

            .action-bar a:hover,
            .action-bar button:hover {
                background: var(--primary-hover);
                transform: translateY(-1px);
            }

        .action-bar .btn-warning {
            background: var(--warning);
        }

            .action-bar .btn-warning:hover {
                background: #d68910;
            }
</style>

<div class="action-bar">
    <a href="@Url.Action("CreateSuKien", "SuKien")">
        <i class="fa-solid fa-plus" style="color: #17a2b8;"></i> Tạo sự kiện mới
    </a>
    <a href="@Url.Action("DangKySuKien", "SuKien")">
        <i class="fa-solid fa-user-plus" style="color: #007bff;"></i> Đăng ký sự kiện cho Tình nguyện viên
    </a>
    <a href="@Url.Action("DangKySuKienChoTreEm", "SuKien")">
        <i class="fa-solid fa-user-plus" style="color: #6f42c1;"></i> Đăng ký sự kiện cho trẻ em
    </a>
    <button class="btn-warning" onclick="openDangKyModal()">
        <i class="fa-solid fa-list-check" style="color: #fd7e14;"></i> Quản lý đăng ký
    </button>

</div>
<div class="filter-tabs">
    <button class="filter-tab active" onclick="filterEvents('all')">
        <i class="fa-solid fa-bars" style="color: #6c757d;"></i> Tất cả
    </button>
    <button class="filter-tab" onclick="filterEvents('upcoming')">
        <i class="fa-solid fa-calendar-days" style="color: #007bff;"></i> Sắp diễn ra
    </button>
    <button class="filter-tab" onclick="filterEvents('ongoing')">
        <i class="fa-solid fa-hourglass-half" style="color: #ffc107;"></i> Đang diễn ra
    </button>
    <button class="filter-tab" onclick="filterEvents('completed')">
        <i class="fa-solid fa-circle-check" style="color: #28a745;"></i> Đã kết thúc
    </button>
</div>

<div class="events-grid" id="eventsGrid"></div>

<script>
    let eventsData = [];

    // 🔹 Gọi dữ liệu từ API backend thật
    async function loadEvents() {
        try {
            const response = await fetch('/SuKien/GetAll');
            const data = await response.json();

            if (data.error) {
                showNotification(data.message, "danger");
                return;
            }

            // Gắn thêm trường trạng thái dựa trên ngày bắt đầu / kết thúc
            const now = new Date();

            eventsData = data.map(e => {
                const a = new Date(parseInt(e.NgayBatDau.match(/\d+/)[0]));
                const b = new Date(parseInt(e.NgayKetThuc.match(/\d+/)[0]));

                let trangThai = '';

                if (b < now) trangThai = 'Đã kết thúc';
                else if (a > now) trangThai = 'Sắp diễn ra';
                else trangThai = 'Đang diễn ra';

                return {
                    ...e,
                    TrangThai: trangThai
                };
            });

            renderEvents(); // render mặc định tất cả
        } catch (error) {
            console.error(error);
            showNotification("Không thể kết nối đến API sự kiện!", "danger");
        }
    }


    // 🔹 Render danh sách sự kiện
    function renderEvents(filter = 'all') {
        const grid = document.getElementById('eventsGrid');
        grid.innerHTML = '';

        const filtered = eventsData.filter(e => {
            if (filter === 'all') return true;
            if (filter === 'upcoming') return e.TrangThai === 'Sắp diễn ra';
            if (filter === 'ongoing') return e.TrangThai === 'Đang diễn ra';
            if (filter === 'completed') return e.TrangThai === 'Đã kết thúc';
            return true;
        });

        if (filtered.length === 0) {
            grid.innerHTML = `<p style="text-align:center;color:gray;">Không có sự kiện nào.</p>`;
            return;
        }

        filtered.forEach(event => {
            const card = document.createElement('div');
            card.className = 'event-card';
            card.onclick = () => viewEvent(event.SuKienId);

            const start = new Date(parseInt(event.NgayBatDau.match(/\d+/)[0])).toLocaleDateString('vi-VN');
            const end = new Date(parseInt(event.NgayKetThuc.match(/\d+/)[0])).toLocaleDateString('vi-VN');
            const statusClass = getStatusClass(event.TrangThai);
            card.innerHTML = `
    <div class="event-image ${statusClass}">
        <img src="https://localhost:44362${event.AnhSuKien}"
             alt="${event.TenSuKien}"
             style="width: 100%; height: 180px; object-fit: cover; border-radius: 10px 10px 0 0;">
    </div>
                <div class="event-content">
                    <h3 class="event-title">${event.TenSuKien}</h3>
                    <div class="event-meta">
                        <div class="meta-item">
                            <span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#007bff" stroke-width="2" style="vertical-align: middle;">
    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
    <line x1="16" y1="2" x2="16" y2="6"></line>
    <line x1="8" y1="2" x2="8" y2="6"></line>
    <line x1="3" y1="10" x2="21" y2="10"></line>
  </svg>
</span>
                            <span>${start} - ${end}</span>
                        </div>
                        <div class="meta-item">
                          <span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="#dc3545" stroke="#dc3545" stroke-width="2" style="vertical-align: middle;">
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
    <circle cx="12" cy="10" r="3" fill="#fff"></circle>
  </svg>
</span>
                            <span>${event.DiaDiem}</span>
                        </div>
                        <div class="meta-item">
                       <span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#28a745" stroke-width="2" style="vertical-align: middle;">
    <circle cx="12" cy="12" r="10"></circle>
    <polyline points="12 6 12 12 16 14"></polyline>
  </svg>
</span>
                            <span class="badge ${statusClass}">${event.TrangThai}</span>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-sm btn-view" data-id="${event.SuKienId}">  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
 Xem chi tiết</button>
                        <button class="btn btn-sm btn-edit" onclick="event.stopPropagation(); editEvent(${event.SuKienId})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
  </svg> Sửa</button>
                    </div>
                </div>
            `;


            grid.appendChild(card);
        });
    }

    // 🔹 CSS trạng thái
    function getStatusClass(status) {
        if (!status) return '';
        status = status.toLowerCase();
        if (status.includes('sắp')) return 'status-upcoming';
        if (status.includes('đang')) return 'status-ongoing';
        if (status.includes('kết thúc')) return 'status-completed';
        return '';
    }

    // 🔹 Chuyển định dạng ngày
    function formatDate(dateString) {
        if (!dateString) return '';
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN');
    }

    // 🔹 Lọc
    function filterEvents(status) {
        const tabs = document.querySelectorAll('.filter-tab');
        tabs.forEach(tab => tab.classList.remove('active'));
        event.target.classList.add('active');
        renderEvents(status);
    }

    // 🔹 Giả lập các hành động
    function viewEvent(id) {
        showNotification(`Xem chi tiết sự kiện #${id}`, 'info');
    }

    function editEvent(id) {
        // Hiển thị thông báo (tuỳ chọn)
        showNotification(`🔧 Đang mở trang chỉnh sửa sự kiện #${id}`, 'info');

        // Chuyển hướng sang trang EditSuKien.cshtml
        window.location.href = `/SuKien/EditSuKien/${id}`;
    }


    function openCreateEventModal() {
        showNotification('Mở form tạo sự kiện mới', 'info');
    }

    // 🔹 Hiển thị thông báo
    function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        const icons = { success: '✓', warning: '⚠', info: 'ℹ', danger: '✕' };
        const colors = {
            success: '#4caf50',
            warning: '#ff9800',
            info: '#2196f3',
            danger: '#f44336'
        };

        notification.innerHTML = `
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 20px;">${icons[type]}</span>
                <span>${message}</span>
            </div>
        `;
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            padding: 16px 24px;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            z-index: 10001;
            animation: slideIn 0.3s ease;
            border-left: 4px solid ${colors[type]};
        `;
        document.body.appendChild(notification);
        setTimeout(() => { notification.remove(); }, 3000);
    }
    document.addEventListener('click', e => {
        const btn = e.target.closest('.btn-view');
        if (!btn) return;
        const id = btn.getAttribute('data-id');
        if (id) {
            window.location.href = `/SuKien/ChiTiet/${id}`;
        }
    });
    // 🔹 Khởi chạy khi load trang
    document.addEventListener("DOMContentLoaded", loadEvents);
</script>


<div id="dangKyModal" class="modal fade" tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">📋 Quản lý đăng ký sự kiện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sự kiện</th>
                            <th>Người đăng ký</th>
                            <th>Ngày đăng ký</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="tableDangKy">
                        <tr><td colspan="6" class="text-center text-muted">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<style>
    .modal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
    }
</style>
<script>

    // Mở modal
    function openDangKyModal() {
        const modal = new bootstrap.Modal(document.getElementById("dangKyModal"));
        modal.show();
        loadDangKySuKien();
    }

    // Load danh sách đăng ký từ API
    async function loadDangKySuKien() {
        const tbody = document.getElementById("tableDangKy");
        tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">⏳ Đang tải...</td></tr>`;

        try {
            const res = await fetch('https://localhost:44362/api/SuKien/getalldangkysukien');
            if (!res.ok) throw new Error("Không thể tải danh sách");
            const data = await res.json();

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Không có đăng ký nào.</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            data.forEach((item, idx) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                <td>${idx + 1}</td>
                <td>${item.tenSuKien}</td>
                <td>${item.hoTenNguoiDung}</td>
                <td>${item.ngayDangKy}</td>
                <td>
                    <span class="badge ${getBadgeClass(item.trangThai)}">${item.trangThai}</span>
                </td>
              <td class="text-center">
                <button class="btn-approve me-1" onclick="approveDangKy(${item.dangKySuKienId})">Duyệt</button>
                <button class="btn-reject me-1" onclick="rejectDangKy(${item.dangKySuKienId})">Từ chối</button>
                <button class="btn-delete" onclick="deleteDangKy(${item.dangKySuKienId})">Xóa</button>
            </td>

            `;
                tbody.appendChild(row);
            });
        } catch (err) {
            console.error(err);
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">❌ Lỗi tải dữ liệu</td></tr>`;
        }
    }

    // Badge màu trạng thái
    function getBadgeClass(status) {
        status = status?.toLowerCase();
        if (status.includes('chờ')) return 'bg-warning text-dark';
        if (status.includes('đã duyệt')) return 'bg-success';
        if (status.includes('từ chối')) return 'bg-danger';
        return 'bg-secondary';
    }

    // Action: Duyệt
    async function approveDangKy(id) {
        if (!confirm("Xác nhận duyệt đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/approve/${id}`, { method: 'PUT' });
        if (res.ok) {
            showNotification("✅ Đã duyệt đăng ký!", "success");
            loadDangKySuKien();
        } else showNotification("Lỗi duyệt đăng ký!", "danger");
    }

    // Action: Từ chối
    async function rejectDangKy(id) {
        if (!confirm("Bạn có chắc muốn từ chối đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/reject/${id}`, { method: 'PUT' });
        if (res.ok) {
            showNotification("❌ Đã từ chối đăng ký!", "warning");
            loadDangKySuKien();
        } else showNotification("Lỗi từ chối!", "danger");
    }

    // Action: Xóa
    async function deleteDangKy(id) {
        if (!confirm("Bạn có chắc muốn xóa đăng ký này?")) return;
        const res = await fetch(`https://localhost:44362/api/SuKien/deletedangky/${id}`, { method: 'DELETE' });
        if (res.ok) {
            showNotification("🗑️ Đã xóa đăng ký!", "success");
            loadDangKySuKien();
        } else showNotification("Lỗi xóa đăng ký!", "danger");
    }

</script>
@section scripts {
    <!-- ✅ Thêm dòng này để có bootstrap.Modal -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}