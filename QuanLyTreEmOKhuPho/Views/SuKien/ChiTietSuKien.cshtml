@model QuanLyTreEmOKhuPho.Models.SuKienDetailVM
@{
    ViewBag.Title = "Chi tiết sự kiện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ThemTreEm.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item active">
            <div class="step-circle">1</div>
            <div class="step-label">Thông tin chung</div>
        </div>
        <div class="step-item">
            <div class="step-circle">2</div>
            <div class="step-label">Tiết mục</div>
        </div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <div class="step-label">Chi phí</div>
        </div>
    </div>
</div>

<div class="form-container">
    <!-- TAB 1: Thông tin chung -->
    <div class="form-step active" id="tab1">
        <h3 class="section-title text-primary">📋 Thông tin sự kiện</h3>

        <div class="form-grid full">
            <div class="photo-upload">
                <div class="photo-preview" style="background-image:url('/img/event-default.jpg');">
                    <span id="photoIcon" style="display:none;"><i class="fa-solid fa-camera"></i></span>
                </div>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group full">
                <label class="form-label">Tên sự kiện</label>
                <input type="text" class="form-control" value="@Model.TenSuKien" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="text" class="form-control" value="@Model.NgayBatDau" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày kết thúc</label>
                <input type="text" class="form-control" value="@Model.NgayKetThuc" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Địa điểm</label>
                <input type="text" class="form-control" value="@Model.DiaDiem" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Khu phố</label>
                <input type="text" class="form-control" value="@Model.KhuPho" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Người phụ trách</label>
                <input type="text" class="form-control" value="@Model.NguoiChiuTrachNhiem" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Mô tả</label>
                <textarea class="form-control" rows="3" readonly>@Model.MoTa</textarea>
            </div>
        </div>

        <h4 class="section-title text-success mt-4">🕓 Thời gian chi tiết</h4>
        @if (Model.ThoiGianChiTiet != null && Model.ThoiGianChiTiet.Count > 0)
        {
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Mô tả</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.ThoiGianChiTiet)
                    {
                        <tr>
                            <td>@t.MoTa</td>
                            <td>@t.ThoiGianBatDau</td>
                            <td>@t.ThoiGianKetThuc</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">Chưa có lịch chi tiết cho sự kiện này.</div>
        }
        <!-- 🌟 DANH SÁCH TRẺ EM THAM GIA -->
        <h4 class="section-title text-primary mt-4">👧 Danh sách trẻ em tham gia</h4>
        <table class="styled-table" id="treEmTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ảnh</th>
                    <th>Họ tên</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Tình trạng</th>
                </tr>
            </thead>
            <tbody id="treEmBody">
                <tr><td colspan="6" class="text-center text-muted">⏳ Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>

    <!-- TAB 2: Tiết mục -->
    <div class="form-step" id="tab2">
        <h3 class="section-title text-primary">🎤 Danh sách tiết mục</h3>

        @if (Model.TietMuc != null && Model.TietMuc.Count > 0)
        {
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Tên tiết mục</th>
                        <th>Người thực hiện</th>
                        <th>Chi phí tiết mục</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TietMuc)
                    {
                        <tr>
                            <td>@t.TenTietMuc</td>
                            <td>@t.NguoiThucHien</td>
                            <td>@string.Format("{0:N0} đ", t.ChiPhiTietMuc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">Chưa có tiết mục nào được thêm vào.</div>
        }
    </div>

    <!-- TAB 3: Chi phí -->
    <div class="form-step" id="tab3">
        <h3 class="section-title text-primary">💰 Thông tin chi phí</h3>

        @if (Model.ChiPhi != null && Model.ChiPhi.Count > 0)
        {
            foreach (var khoan in Model.ChiPhi)
            {
                <div class="cost-card">
                    <h5 class="cost-title">@khoan.TenKhoanChi</h5>
                    <p class="text-muted"><b>Ghi chú:</b> @khoan.GhiChu</p>
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>Tên phần quà</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Người đại diện</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in khoan.ChiTiet)
                            {
                                <tr>
                                    <td>@c.TenPhanQua</td>
                                    <td>@c.SoLuong</td>
                                    <td>@string.Format("{0:N0} đ", c.DonGia)</td>
                                    <td>@c.NguoiDaiDien</td>
                                    <td>@string.Format("{0:N0} đ", c.SoLuong * c.DonGia)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-end fw-bold mt-2">
                        Tổng: @string.Format("{0:N0} đ", khoan.SoTien)
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">Chưa có dữ liệu chi phí.</div>
        }
    </div>

    <!-- Navigation Buttons -->
    <div class="form-actions">
        <button class="btn btn-secondary" type="button" onclick="prevStep()">⬅ Quay lại</button>
        <button class="btn btn-primary" type="button" onclick="nextStep()">Tiếp theo ➡</button>
    </div>
</div>

<script>
    let currentStep = 1;
    const totalSteps = 3;

    function showStep(step) {
        document.querySelectorAll('.form-step').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
        document.querySelectorAll('.step-item').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
    }

    function nextStep() {
        if (currentStep < totalSteps) {
            currentStep++;
            showStep(currentStep);
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            showStep(currentStep);
        }
    }
  document.addEventListener("DOMContentLoaded", async () => {
        const suKienId = "@Model.SuKienId";
        const tbody = document.getElementById("treEmBody");

        try {
            const res = await fetch(`https://localhost:44362/api/SuKien/${suKienId}/trethamgiaSK`);
            const data = await res.json();

            tbody.innerHTML = "";

            if (!data || data.length === 0 || data.message) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Chưa có trẻ nào tham gia sự kiện này.</td></tr>`;
                return;
            }

            data.forEach((tre, index) => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td><img src="${tre.anh || '/img/no-avatar.png'}" style="width:50px;height:50px;border-radius:50%;object-fit:cover;"></td>
                    <td>${tre.hoTen}</td>
                    <td>${tre.gioiTinh}</td>
                    <td>${new Date(tre.ngaySinh).toLocaleDateString('vi-VN')}</td>
                    <td>${tre.tinhTrang || ''}</td>`;
                tbody.appendChild(row);
            });
        } catch (err) {
            console.error(err);
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">❌ Lỗi tải danh sách trẻ tham gia</td></tr>`;
        }
    });
</script>

<style>
    .styled-table img {
        border: 2px solid #eee;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }
    .cost-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        margin-bottom: 20px;
        transition: transform 0.2s;
    }

        .cost-card:hover {
            transform: scale(1.01);
        }

    .cost-title {
        color: #0d6efd;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }

        .styled-table th, .styled-table td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .styled-table th {
            background-color: #f5f7fb;
        }

    .section-title {
        border-left: 4px solid #0d6efd;
        padding-left: 10px;
        margin-bottom: 15px;
    }
</style>
