@model QuanLyTreEmOKhuPho.Models.SuKienDetailVM
@{
    ViewBag.Title = "Chi tiết sự kiện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ThemTreEm.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="step-container">
    <div class="step-progress">
        <div class="step-item active">
            <div class="step-circle">1</div>
            <div class="step-label">Thông tin chung</div>
        </div>
        <div class="step-item">
            <div class="step-circle">2</div>
            <div class="step-label">Tiết mục</div>
        </div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <div class="step-label">Chi phí</div>
        </div>
    </div>
</div>

<div class="form-container">
    <!-- TAB 1: Thông tin chung -->
    <div class="form-step active" id="tab1">
        <h3 class="section-title text-primary">📋 Thông tin sự kiện</h3>

        <div class="photo-upload">
            <div class="photo-preview"
                 style="
             background-image:url('@(string.IsNullOrEmpty(Model.AnhSuKien)
                                     ? "/img/event-default.jpg"
                                     : "https://localhost:44362" + Model.AnhSuKien)');
             background-size:cover;
             background-position:center;
             background-repeat:no-repeat;
             border-radius:10px; ">
            </div>
        </div>



        <div class="form-grid">
            <div class="form-group full">
                <label class="form-label">Tên sự kiện</label>
                <input type="text" class="form-control" value="@Model.TenSuKien" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="text" class="form-control" value="@Model.NgayBatDau" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày kết thúc</label>
                <input type="text" class="form-control" value="@Model.NgayKetThuc" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Địa điểm</label>
                <input type="text" class="form-control" value="@Model.DiaDiem" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Khu phố</label>
                <input type="text" class="form-control" value="@Model.KhuPho.TenKhuPho" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Người phụ trách</label>
                <input type="text" class="form-control" value="@Model.NguoiChiuTrachNhiem" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Mô tả</label>
                <textarea class="form-control" rows="3" readonly>@Model.MoTa</textarea>
            </div>
        </div>

        <h4 class="section-title text-success mt-4">🕓 Thời gian chi tiết</h4>
        @if (Model.ThoiGianChiTiet != null && Model.ThoiGianChiTiet.Count > 0)
        {
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Mô tả</th>
                        <th>Bắt đầu</th>
                        <th>Kết thúc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.ThoiGianChiTiet)
                    {
                        <tr>
                            <td>@t.MoTa</td>
                            <td>@t.ThoiGianBatDau</td>
                            <td>@t.ThoiGianKetThuc</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">Chưa có lịch chi tiết cho sự kiện này.</div>
        }
        <!-- 🌟 DANH SÁCH TRẺ EM THAM GIA -->
        <h4 class="section-title text-primary mt-4">👧 Danh sách trẻ em tham gia</h4>
        <table class="styled-table" id="treEmTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ảnh</th>
                    <th>Họ tên</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Tình trạng</th>
                </tr>
            </thead>
            <tbody id="treEmBody">
                <tr><td colspan="6" class="text-center text-muted">⏳ Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>

        <h4 class="section-title text-warning mt-4">🤝 Danh sách tình nguyện viên</h4>

        <div class="d-flex mb-2">
            <input id="searchTNV" type="text" class="form-control" placeholder="🔍 Tìm tên tình nguyện viên..." oninput="filterTNV()" style="max-width:250px;">
        </div>

        <table class="styled-table" id="tnvTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ảnh</th>
                    <th>Họ tên</th>
                    <th>Công việc</th>
                    <th>Ghi chú</th>
                    <th>Đánh giá</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody id="tnvBody">
                <tr><td colspan="7" class="text-center text-muted">⏳ Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>

        <div id="paginationTNV" class="d-flex justify-content-center mt-3"></div>



    </div>
    <!-- TAB 2: Tiết mục -->
    <div class="form-step" id="tab2">
        <h3 class="section-title text-primary">🎤 Danh sách tiết mục theo từng thời gian</h3>

        @if (Model.ThoiGianChiTiet != null && Model.ThoiGianChiTiet.Count > 0)
        {
            foreach (var tg in Model.ThoiGianChiTiet)
            {
                <div class="time-block">
                    <h4 class="text-info fw-bold">
                        ⏰ @tg.MoTa
                        <small class="text-muted">(@tg.ThoiGianBatDau → @tg.ThoiGianKetThuc)</small>
                    </h4>

                    @if (tg.TietMuc != null && tg.TietMuc.Count > 0)
                    {
                        <table class="styled-table mb-4">
                            <thead>
                                <tr>
                                    <th>Tên tiết mục</th>
                                    <th>Người thực hiện</th>
                                    <th>Chi phí</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tm in tg.TietMuc)
                                {
                                    <tr>
                                        <td>@tm.TenTietMuc</td>
                                        <td>@tm.NguoiThucHien</td>
                                        <td>@string.Format("{0:N0} đ", tm.ChiPhiTietMuc ?? 0)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>


                    }
                    else
                    {
                        <div class="alert alert-secondary">Không có tiết mục nào.</div>
                    }
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">Không có thời gian chi tiết.</div>
        }
    </div>



    <!-- TAB 3: Chi phí -->
    <div class="form-step" id="tab3">
        <h3 class="section-title text-primary">💰 Thông tin chi phí</h3>

        @if (Model.ChiPhi != null && Model.ChiPhi.Count > 0)
        {
            foreach (var khoan in Model.ChiPhi)
            {
                <div class="cost-card">
                    <h5 class="cost-title">@khoan.TenKhoanChi</h5>
                    <p class="text-muted"><b>Ghi chú:</b> @khoan.GhiChu</p>
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>Tên phần quà</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Người đại diện</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in khoan.ChiTiet)
                            {
                                <tr>
                                    <td>@c.TenPhanQua</td>
                                    <td>@c.SoLuong</td>
                                    <td>@string.Format("{0:N0} đ", c.DonGia)</td>
                                    <td>@c.NguoiDaiDien</td>
                                    <td>@string.Format("{0:N0} đ", c.SoLuong * c.DonGia)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-end fw-bold mt-2">
                        Tổng: @string.Format("{0:N0} đ", khoan.SoTien)
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">Chưa có dữ liệu chi phí.</div>
        }
    </div>

    <!-- Navigation Buttons -->
    <div class="form-actions">
        <button class="btn btn-secondary" type="button" onclick="prevStep()">⬅ Quay lại</button>
        <button class="btn btn-primary" type="button" onclick="nextStep()">Tiếp theo ➡</button>
    </div>
</div>

<script>
    $(document).ready(() => {
        loadTinhNguyenVien();

    });


    let TNV_FULL_DATA = [];
    let TNV_FILTERED = [];
    let TNV_PAGE = 1;            
    const TNV_PAGE_SIZE = 5;

async function loadTinhNguyenVien() {
    const suKienId = "@Model.SuKienId";
    const baseUrl = "https://localhost:44362";
    const tbody = document.getElementById("tnvBody");

    tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">⏳ Đang tải dữ liệu...</td></tr>`;

    try {
        const res = await fetch(`${baseUrl}/api/SuKien/${suKienId}/tinhnguyenvien`);
        const data = await res.json();

        TNV_FULL_DATA = data;
        TNV_FILTERED = [...TNV_FULL_DATA];
        TNV_PAGE = 1;   

        renderTNVPage();

    } catch (err) {
        console.error(err);
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger">❌ Lỗi tải dữ liệu</td></tr>`;
    }
}

    function renderTNVPage() {
        const tbody = document.getElementById("tnvBody");
        const baseUrl = "https://localhost:44362";

        tbody.innerHTML = "";

        const start = (TNV_PAGE - 1) * TNV_PAGE_SIZE;
        const end = start + TNV_PAGE_SIZE;
        const pageData = TNV_FILTERED.slice(start, end);

        const danhGiaList = [
            "Hoàn thành tốt",
            "Chưa hoàn thành tốt",
            "Không hoàn thành tốt",
            "Không hoàn thành",
            "Vắng"
        ];

        if (pageData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted">Không có tình nguyện viên.</td></tr>`;
            return;
        }

        pageData.forEach((tnv, i) => {
            const pc = tnv.phanCong;
            const row = document.createElement("tr");
            row.innerHTML = `
            <td>${start + i + 1}</td>
            <td><img src="${tnv.anh ? baseUrl + tnv.anh : '/img/no-avatar.png'}"
                     style="width:45px;height:45px;border-radius:50%;object-fit:cover;"></td>
            <td>${tnv.hoTen}</td>

            <td><input class="form-control pc-congviec" value="${pc?.congViec || ''}"></td>
            <td><input class="form-control pc-ghichu" value="${pc?.ghiChu || ''}"></td>

            <td>
                <select class="form-control pc-danhgia">
                    <option value="">-- Chọn --</option>
                    ${danhGiaList.map(x =>
                `<option value="${x}" ${pc?.danhGiaCongViec === x ? "selected" : ""}>${x}</option>`
            ).join("")}
                </select>
            </td> 

            <td>
                ${pc == null
                    ? `<button class="btn btn-success btn-sm" onclick="createPhanCong(${tnv.tinhNguyenVienId})">Giao việc</button>`
                    : `<button class="btn btn-primary btn-sm" onclick="updatePhanCong(${pc.phanCongId}, this)">Lưu</button>
                       <button class="btn btn-danger btn-sm" onclick="deletePhanCong(${pc.phanCongId})">Xóa</button>`
                }
            </td>
        `;
            tbody.appendChild(row);
        });

        renderPaginationButtons();
    }
    function renderPaginationButtons() {
        const container = document.getElementById("paginationTNV");
        container.innerHTML = "";

        const totalPages = Math.ceil(TNV_FILTERED.length / TNV_PAGE_SIZE);
        if (totalPages <= 1) return;

        let html = `<ul class="pagination">`;

        // Prev
        html += `
        <li class="page-item ${TNV_PAGE === 1 ? 'disabled' : ''}">
            <a class="page-link" onclick="goToPage(${TNV_PAGE - 1})">Prev</a>
        </li>
    `;

        // các nút trang (hiển thị tối đa 5)
        const maxButtons = 5;
        let start = Math.max(1, TNV_PAGE - 2);
        let end = Math.min(totalPages, start + maxButtons - 1);

        if (end - start < maxButtons - 1) {
            start = Math.max(1, end - maxButtons + 1);
        }

        for (let i = start; i <= end; i++) {
            html += `
            <li class="page-item ${i === TNV_PAGE ? 'active' : ''}">
                <a class="page-link" onclick="goToPage(${i})">${i}</a>
            </li>
        `;
        }

        // Next
        html += `
        <li class="page-item ${TNV_PAGE === totalPages ? 'disabled' : ''}">
            <a class="page-link" onclick="goToPage(${TNV_PAGE + 1})">Next</a>
        </li>
    `;

        html += `</ul>`;

        container.innerHTML = html;
    }
    function goToPage(page) {
        const totalPages = Math.ceil(TNV_FILTERED.length / TNV_PAGE_SIZE);
        if (page < 1 || page > totalPages) return;

        TNV_PAGE = page;
        renderTNVPage();
    }

    function filterTNV() {
        const keyword = document.getElementById("searchTNV").value.toLowerCase();

        TNV_FILTERED = TNV_FULL_DATA.filter(t =>
            t.hoTen.toLowerCase().includes(keyword)
        );

        TNV_PAGE = 1; // reset
        renderTNVPage();
    }


async function createPhanCong(tnvId) {
    const suKienId = "@Model.SuKienId";
    const row = event.target.closest("tr");

    const model = {
        suKienID: parseInt(suKienId),
        tinhNguyenVienID: tnvId,
        congViec: row.querySelector(".pc-congviec").value,
        ghiChu: row.querySelector(".pc-ghichu").value
    };

    const res = await fetch("https://localhost:44362/api/SuKien/phancong", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(model)
    });

    const data = await res.json();

    alert(data.message);
    loadTinhNguyenVien();
}
    async function updatePhanCong(phanCongId, btn) {
        const row = btn.closest("tr");

        const model = {
            congViec: row.querySelector(".pc-congviec").value,
            ghiChu: row.querySelector(".pc-ghichu").value,
            danhGiaCongViec: row.querySelector(".pc-danhgia").value
        };

        const res = await fetch(`https://localhost:44362/api/SuKien/phancong/${phanCongId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(model)
        });

        const data = await res.json();
        alert(data.message);
    }
    async function deletePhanCong(phanCongId) {
        if (!confirm("Bạn có chắc muốn xóa phân công này?")) return;

        const res = await fetch(`https://localhost:44362/api/SuKien/phancong/${phanCongId}`, {
            method: "DELETE"
        });

        const data = await res.json();
        alert(data.message);

        loadTinhNguyenVien();
    }

    let currentStep = 1;
    const totalSteps = 3;

    function showStep(step) {
        document.querySelectorAll('.form-step').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
        document.querySelectorAll('.step-item').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
    }

    function nextStep() {
        if (currentStep < totalSteps) {
            currentStep++;
            showStep(currentStep);
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            showStep(currentStep);
        }
    }
    const baseUrl = "https://localhost:44362";

  document.addEventListener("DOMContentLoaded", async () => {
        const suKienId = "@Model.SuKienId";
        const tbody = document.getElementById("treEmBody");

        try {
            const res = await fetch(`https://localhost:44362/api/SuKien/${suKienId}/trethamgiaSK`);
            const data = await res.json();

            tbody.innerHTML = "";

            if (!data || data.length === 0 || data.message) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Chưa có trẻ nào tham gia sự kiện này.</td></tr>`;
                return;
            }

            data.forEach((tre, index) => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${index + 1}</td>
                  <td>
    <img src="${tre.anh ? baseUrl + tre.anh : '/img/no-avatar.png'}"
         style="width:50px;height:50px;border-radius:50%;object-fit:cover;">
</td>

                    <td>${tre.hoTen}</td>
                    <td>${tre.gioiTinh}</td>
                    <td>${new Date(tre.ngaySinh).toLocaleDateString('vi-VN')}</td>
                    <td>${tre.tinhTrang || ''}</td>`;
                tbody.appendChild(row);
            });
        } catch (err) {
            console.error(err);
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">❌ Lỗi tải danh sách trẻ tham gia</td></tr>`;
        }
    });
</script>

<style>
    .pagination {
        list-style: none;
        display: flex;
        gap: 6px;
    }

    .page-item {
        cursor: pointer;
    }

        .page-item.disabled .page-link {
            pointer-events: none;
            opacity: 0.5;
        }

    .page-link {
        padding: 6px 12px;
        border: 1px solid #ddd;
        border-radius: 5px;
        background: #fff;
    }

    .page-item.active .page-link {
        background: #0d6efd;
        color: white;
        border-color: #0d6efd;
    }

    .styled-table img {
        border: 2px solid #eee;
        box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }

    .cost-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        margin-bottom: 20px;
        transition: transform 0.2s;
    }

        .cost-card:hover {
            transform: scale(1.01);
        }

    .cost-title {
        color: #0d6efd;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }

        .styled-table th, .styled-table td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .styled-table th {
            background-color: #f5f7fb;
        }

    .section-title {
        border-left: 4px solid #0d6efd;
        padding-left: 10px;
        margin-bottom: 15px;
    }
</style>
