@model QuanLyTreEmOKhuPho.Models.SuKienDetailVM
@{
    ViewBag.Title = "Chi tiết sự kiện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ThemTreEm.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item active">
            <div class="step-circle">1</div>
            <div class="step-label">Thông tin chung</div>
        </div>
        <div class="step-item">
            <div class="step-circle">2</div>
            <div class="step-label">Chi phí</div>
        </div>
    </div>
</div>

<div class="form-container">
    <!-- Bước 1: Thông tin chung -->
    <div class="form-step active" id="tab1">
        <h3 class="section-title text-primary">📋 Thông tin sự kiện</h3>
        <div class="form-grid full">
            <div class="photo-upload">
                <div class="photo-preview" style="background-image:url('/img/event-default.jpg');">
                    <span id="photoIcon" style="display:none;"><i class="fa-solid fa-camera"></i></span>
                </div>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group full">
                <label class="form-label">Tên sự kiện</label>
                <input type="text" class="form-control" value="@Model.TenSuKien" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày bắt đầu</label>
                <input type="text" class="form-control" value="@Model.NgayBatDau?.ToString(" dd /MM/yyyy")" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Ngày kết thúc</label>
                <input type="text" class="form-control" value="@Model.NgayKetThuc?.ToString(" dd /MM/yyyy")" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Địa điểm</label>
                <input type="text" class="form-control" value="@Model.DiaDiem" readonly />
            </div>
            <div class="form-group">
                <label class="form-label">Khu phố</label>
                <input type="text" class="form-control" value="@Model.KhuPho" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Người phụ trách</label>
                <input type="text" class="form-control" value="@Model.NguoiChiuTrachNhiem" readonly />
            </div>
            <div class="form-group full">
                <label class="form-label">Mô tả</label>
                <textarea class="form-control" rows="3" readonly>@Model.MoTa</textarea>
            </div>
        </div>
    </div>

    <!-- Bước 2: Chi phí -->
    <div class="form-step" id="tab2">
        <h3 class="section-title text-primary">💰 Thông tin chi phí</h3>

        @if (Model.ChiPhi != null && Model.ChiPhi.Count > 0)
        {
            foreach (var khoan in Model.ChiPhi)
            {
                <div class="cost-card">
                    <h5 class="cost-title">@khoan.TenKhoanChi</h5>
                    <p class="text-muted"><b>Ghi chú:</b> @khoan.GhiChu</p>
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>Tên phần quà</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Người đại diện</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in khoan.ChiTiet)
                            {
                                <tr>
                                    <td>@c.TenPhanQua</td>
                                    <td>@c.SoLuong</td>
                                    <td>@string.Format("{0:N0} đ", c.DonGia)</td>
                                    <td>@c.NguoiDaiDien</td>
                                    <td>@string.Format("{0:N0} đ", c.SoLuong * c.DonGia)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-end fw-bold mt-2">
                        Tổng: @string.Format("{0:N0} đ", khoan.SoTien)
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">Chưa có dữ liệu chi phí.</div>
        }
    </div>

    <!-- Nút điều hướng -->
    <div class="form-actions">
        <button class="btn btn-secondary" type="button" onclick="prevStep()">Quay lại</button>
        <button class="btn btn-primary" type="button" onclick="nextStep()">Tiếp theo</button>
    </div>
</div>

<script>
    let currentStep = 1;
    const totalSteps = 2;

    function showStep(step) {
        document.querySelectorAll('.form-step').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
        document.querySelectorAll('.step-item').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
    }

    function nextStep() {
        if (currentStep < totalSteps) {
            currentStep++;
            showStep(currentStep);
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            showStep(currentStep);
        }
    }
</script>

<style>
    .cost-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.05);
        margin-bottom: 20px;
        transition: transform 0.2s;
    }

        .cost-card:hover {
            transform: scale(1.01);
        }

    .cost-title {
        color: #0d6efd;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .styled-table th {
        background-color: #f5f7fb;
    }

    .section-title {
        border-left: 4px solid #0d6efd;
        padding-left: 10px;
        margin-bottom: 15px;
    }
</style>
