@model QuanLyTreEmOKhuPho.Models.SuKienDetailVM
@{
    ViewBag.Title = "Chỉnh sửa sự kiện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ThemTreEm.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item active"><div class="step-circle">1</div><div class="step-label">Thông tin</div></div>
        <div class="step-item"><div class="step-circle">2</div><div class="step-label">Tiết mục</div></div>
        <div class="step-item"><div class="step-circle">3</div><div class="step-label">Chi phí</div></div>
    </div>
</div>

<div class="form-container">
    <!-- TAB 1: Thông tin chung -->
    <div class="form-step active" id="tab1">
        <h3 class="section-title text-primary">📋 Chỉnh sửa thông tin sự kiện</h3>

        <div class="form-grid">

            <div class="form-group full">
                <label>Tên sự kiện</label>
                <input id="TenSuKien" class="form-control" value="@Model.TenSuKien" />
            </div>
            <div class="form-group">
                <label>Ngày bắt đầu</label>
                <input id="NgayBatDau" type="date" class="form-control" value="@(Model.NgayBatDau?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-group">
                <label>Ngày kết thúc</label>
                <input id="NgayKetThuc" type="date" class="form-control" value="@(Model.NgayKetThuc?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-group">
                <label>Địa điểm</label>
                <input id="DiaDiem" class="form-control" value="@Model.DiaDiem" />
            </div>
            <div class="form-group">
                <label>Khu phố</label>
                <input id="KhuPho" class="form-control" value="@Model.KhuPho.TenKhuPho" />
            </div>
            <div class="form-group full">
                <label>Người phụ trách</label>
                <input id="NguoiChiuTrachNhiem" class="form-control" value="@Model.NguoiChiuTrachNhiem" />
            </div>
            <div class="form-group full">
                <label>Mô tả</label>
                <textarea id="MoTa" class="form-control" rows="3">@Model.MoTa</textarea>
            </div>
        </div>
    </div>
    <div class="form-step" id="tab2">
        <h3 class="section-title text-primary">🎤 Chỉnh sửa tiết mục theo thời gian</h3>


        @if (Model.ThoiGianChiTiet?.Count > 0)
        {
            int index = 0;
            foreach (var time in Model.ThoiGianChiTiet)
            {
                <div class="border p-3 mb-3 rounded bg-light">
                    <h5>🕒 @time.MoTa (@time.ThoiGianBatDau - @time.ThoiGianKetThuc</h5>
                    <input type="hidden" class="time-id" value="@time.ThoiGianChiTietSuKienId" />


                    <table class="styled-table table-tietmuc" data-index="@index">
                        <thead>
                            <tr>
                                <th>Tên tiết mục</th>
                                <th>Người thực hiện</th>
                                <th>Chi phí (đ)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tietmuc in time.TietMuc)
                            {
                                <tr>
                                    <td><input class="form-control tm-name" value="@tietmuc.TenTietMuc" /></td>
                                    <td><input class="form-control tm-person" value="@tietmuc.NguoiThucHien" /></td>
                                    <td><input class="form-control tm-cost" type="number" value="@tietmuc.ChiPhiTietMuc" /></td>
                              @*      <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">Xóa</button></td>*@
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                index++;
            }
        }
        else
        {
            <div class="alert alert-warning">Không có thời gian chi tiết sự kiện nào.</div>
        }
    </div>

    <!-- TAB 3: Chi phí -->
    <div class="form-step" id="tab3">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="section-title text-primary">💰 Chỉnh sửa chi phí</h3>
        @*    <button type="button" class="btn btn-success btn-sm" onclick="addChiPhi()">➕ Thêm khoản chi</button>*@
        </div>

        <table id="tableChiPhi" class="styled-table">
            <thead><tr><th>Tên khoản chi</th><th>Ghi chú</th><th>Số tiền (đ)</th><th></th></tr></thead>
            <tbody>
                @if (Model.ChiPhi?.Count > 0)
                {
                    foreach (var c in Model.ChiPhi)
                    {
                        <tr>
                            <td><input class="form-control cp-name" value="@c.TenKhoanChi" /></td>
                            <td><input class="form-control cp-note" value="@c.GhiChu" /></td>
                            <td><input class="form-control cp-amount" type="number" value="@c.SoTien" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Buttons -->
    <div class="form-actions">
        <button class="btn btn-secondary" type="button" onclick="prevStep()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle;">
                <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
            </svg> Quay lại
        </button>
        <button class="btn btn-primary" type="button" onclick="nextStep()">
            Tiếp  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-left: 5px;">
                <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z" />
            </svg>
        </button>
    </div>

    <div class="text-end mt-4">
        <button class="btn btn-success" onclick="updateFullSuKien()"> <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
        <a href="@Url.Action("ChiTiet", "SuKien", new { id = Model.SuKienId })" class="btn btn-secondary">Hủy</a>
    </div>
</div>

<script>
let currentStep = 1;
const totalSteps = 3;

function showStep(step){document.querySelectorAll('.form-step').forEach((s,i)=>s.classList.toggle('active',i+1===step));
document.querySelectorAll('.step-item').forEach((s,i)=>s.classList.toggle('active',i+1===step));}
function nextStep(){if(currentStep<totalSteps)showStep(++currentStep);}
function prevStep(){if(currentStep>1)showStep(--currentStep);}

function removeRow(btn){btn.closest("tr").remove();}
function addTietMuc(){
    const row=`<tr>
        <td><input class="form-control tm-name" /></td>
        <td><input class="form-control tm-person" /></td>
        <td><input class="form-control tm-cost" type="number" /></td>
        <td><button class="btn btn-danger btn-sm" onclick="removeRow(this)">Xóa</button></td></tr>`;
    $("#tableTietMuc tbody").append(row);
}
function addChiPhi(){
    const row=`<tr>
        <td><input class="form-control cp-name" /></td>
        <td><input class="form-control cp-note" /></td>
        <td><input class="form-control cp-amount" type="number" /></td>
        <td><button class="btn btn-danger btn-sm" onclick="removeRow(this)">Xóa</button></td></tr>`;
    $("#tableChiPhi tbody").append(row);
}

// ✅ Gửi PUT API
async function updateFullSuKien(){
    const suKienId="@Model.SuKienId";
    const model={
        SuKienId:suKienId,
        TenSuKien:$("#TenSuKien").val(),
        NgayBatDau:$("#NgayBatDau").val(),
        NgayKetThuc:$("#NgayKetThuc").val(),
        DiaDiem:$("#DiaDiem").val(),
        KhuPho: $("#KhuPho").val(),
        NguoiChiuTrachNhiem:$("#NguoiChiuTrachNhiem").val(),
        MoTa:$("#MoTa").val(),
        TietMuc:$("#tableTietMuc tbody tr").map(function(){
            return{
                TenTietMuc:$(this).find(".tm-name").val(),
                NguoiThucHien:$(this).find(".tm-person").val(),
                ChiPhiTietMuc:parseFloat($(this).find(".tm-cost").val())||0
            };}).get(),
        ChiPhi:$("#tableChiPhi tbody tr").map(function(){
            return{
                TenKhoanChi:$(this).find(".cp-name").val(),
                GhiChu:$(this).find(".cp-note").val(),
                SoTien:parseFloat($(this).find(".cp-amount").val())||0
            };}).get()
    };

    try{
        const res=await fetch(`https://localhost:44362/api/SuKien/${suKienId}/updateAll`,{
            method:'PUT',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify(model)
        });
        const text=await res.text();
        if(res.ok){
            alert("✅ Cập nhật sự kiện thành công!");
            window.location.href=`/SuKien/ChiTiet/${suKienId}`;
        }else alert("❌ Lỗi: "+text);
    }catch(err){alert("❌ Không thể kết nối đến API!");console.error(err);}
}
</script>
<style>
    :root {
        --primary: #0d6efd;
        --light: #f8f9fa;
        --gray: #6c757d;
        --danger: #dc3545;
        --success: #198754;
        --shadow: 0 2px 10px rgba(0, 0, 0, 0.05);
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        box-shadow: var(--shadow);
        border-radius: 8px;
        overflow: hidden;
    }

        .styled-table th, .styled-table td {
            border: 1px solid #dee2e6;
            padding: 8px 10px;
            font-size: 0.95rem;
        }

        .styled-table th {
            background: var(--light);
            font-weight: 600;
        }

        .styled-table tbody tr:hover {
            background-color: #f1f3f5;
        }

    .section-title {
        border-left: 4px solid var(--primary);
        padding-left: 12px;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn {
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 500;
    }

    .btn-primary {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .btn-danger {
        background-color: var(--danger);
        border-color: var(--danger);
    }

    .btn-success {
        background-color: var(--success);
        border-color: var(--success);
    }

    .btn-secondary {
        background-color: var(--gray);
        border-color: var(--gray);
    }

    .form-control {
        border-radius: 6px;
        font-size: 0.95rem;
    }

    .step-container {
        margin-bottom: 2rem;
    }

    .step-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .step-item {
        flex: 1;
        text-align: center;
        position: relative;
    }

    .step-circle {
        width: 32px;
        height: 32px;
        background: var(--gray);
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 5px;
        font-weight: bold;
        box-shadow: var(--shadow);
    }

    .step-item.active .step-circle {
        background: var(--primary);
    }

    .step-label {
        font-size: 0.9rem;
    }

    .form-step {
        animation: fadeIn 0.3s ease-in-out;
    }


        .form-step:not(.active) {
            display: none;
        }

    .table-tietmuc input,
    #tableChiPhi input {
        font-size: 0.9rem;
        padding: 4px 8px;
    }

    .text-end .btn {
        min-width: 120px;
    }

    .alert-warning {
        font-size: 0.95rem;
    }
</style>
