@{
    ViewBag.Title = "ThemTreEm_v2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/ThemTreEm.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/css/media.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item completed">
            <div class="step-circle"><i class="fa-solid fa-check"></i></div>
            <div class="step-label">Thông tin cơ bản</div>
        </div>
        <div class="step-item active">
            <div class="step-circle">2</div>
            <div class="step-label">Phụ huynh</div>
        </div>
        <div class="step-item">
            <div class="step-circle">3</div>
            <div class="step-label">Học tập</div>
        </div>
    </div>
</div>

<div class="form-container">
    <h3 class="section-title">Thông tin phụ huynh</h3>
    <div id="parentsList" class="parent-list"></div>

    <div class="form-grid">
        <div class="form-group"><label>Họ và tên</label><input id="hoTen" class="form-control" /></div>
        <div class="form-group"><label>Số điện thoại</label><input id="sdt" class="form-control" /></div>
        <div class="form-group"><label>Nghề nghiệp</label><input id="ngheNghiep" class="form-control" /></div>
        <div class="form-group"><label>Địa chỉ</label><input id="diaChi" class="form-control" /></div>
    </div>

    <button class="btn btn-primary" type="button" onclick="addParent()">+ Thêm phụ huynh</button>

    <div class="result-section" id="resultSection" style="display:none;">
        <h3 style="margin-bottom: 20px;">Danh sách đã thêm (<span id="totalCount">0</span>)</h3>
        <table>
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>SĐT</th>
                    <th>Nghề nghiệp</th>
                    <th>Địa chỉ</th>
                </tr>
            </thead>
            <tbody id="parentsTableBody"></tbody>
        </table>
    </div>

    <div class="form-actions" style="justify-content:flex-end">
        <button class="btn btn-secondary" onclick="window.history.back()">Quay lại</button>
        <button class="btn btn-secondary">Hủy bỏ</button>
        <button class="btn btn-primary" type="button" onclick="nextStepParent()">Tiếp theo</button>
    </div>
</div>

<script>
    const parentList = [];

    function addParent() {
        const p = {
            HoTen: $("#hoTen").val(),
            SDT: $("#sdt").val(),
            NgheNghiep: $("#ngheNghiep").val(),
            DiaChi: $("#diaChi").val(),
            MoiQuanHe: "Cha/Mẹ",
            DanToc: "Kinh",         // ✅ Bổ sung bắt buộc cho backend
            TonGiao: "Không",       // ✅
            QuocTich: "Việt Nam"    // ✅
        };

        if (!p.HoTen) return alert("Vui lòng nhập họ tên phụ huynh!");
        if (!p.SDT) return alert("Vui lòng nhập số điện thoại!");

        parentList.push(p);
        renderParentList();

        // Xóa input sau khi thêm
        $("#hoTen, #sdt, #ngheNghiep, #diaChi").val("");
    }

    function renderParentList() {
        const tbody = $("#parentsTableBody");
        tbody.empty();
        parentList.forEach((p) => {
            tbody.append(`
                <tr>
                    <td>${p.HoTen}</td>
                    <td>${p.SDT}</td>
                    <td>${p.NgheNghiep}</td>
                    <td>${p.DiaChi}</td>
                </tr>`);
        });
        $("#resultSection").show();
        $("#totalCount").text(parentList.length);
    }

    function nextStepParent() {
        if (parentList.length === 0) {
            return alert("Vui lòng thêm ít nhất 1 phụ huynh trước khi tiếp tục!");
        }
        localStorage.setItem("TreEm_Parents", JSON.stringify(parentList));
        window.location.href = "/QuanLyTreEm/ThemTreEm_v3";
    }
</script>
