@model QuanLyTreEmOKhuPho.Models.TreEmViewModel
@{
    ViewBag.Title = "Chi tiết trẻ em";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ✅ Bật chế độ edit khi query có ?edit=true
    bool isEdit = Request.QueryString["edit"] == "true";
}
<link rel="stylesheet" href="~/Content/css/media.css" />
<link rel="stylesheet" href="~/Content/css/ThemTreEm.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item active"><div class="step-circle">1</div><div class="step-label">Thông tin cơ bản</div></div>
        <div class="step-item"><div class="step-circle">2</div><div class="step-label">Học tập</div></div>
        <div class="step-item"><div class="step-circle">3</div><div class="step-label">Vận động</div></div>
        @*<div class="step-item"><div class="step-circle">4</div><div class="step-label"></div>Hỗ trợ</div>*@
        @*<div class="step-item"><div class="step-circle">5</div><div class="step-label">Sự kiện</div></div>*@
    </div>
</div>

<div class="form-container">
    <!-- TAB 1: THÔNG TIN CƠ BẢN -->
    <div class="form-step active" id="tab1">
        <h3 class="section-title">Thông tin cơ bản</h3>

        <div class="form-grid full">
            <div class="photo-upload">
                <div class="photo-preview" id="photoPreview"
                     style="background-image:url('@(string.IsNullOrEmpty(Model.Anh) ? "/images/default-avatar.png" : Model.Anh)');
            cursor:@(isEdit ? "pointer" : "default");"
                     @(isEdit ? "onclick=document.getElementById('photoInput').click()" : "" )>
                    <span id="photoIcon" style="display:@(isEdit ? " block" : "none" );"><i class="fa-solid fa-camera" style="color: #339af0;"></i></span>
                </div>
                @if (isEdit)
                {
                    <input type="file" id="photoInput" accept="image/*" style="display:none;" />
                }
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label class="form-label">Họ và tên</label>
                @if (isEdit)
                {
                    <input type="text" class="form-control" id="HoTen" value="@Model.HoTen" />
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.HoTen" readonly />
                }
            </div>

            <div class="form-group">
                <label class="form-label">Ngày sinh</label>
                @if (isEdit)
                {
                    <input type="date" class="form-control" id="NgaySinh"
                           name="NgaySinh"
                           value="@(Model.NgaySinh?.ToString("yyyy-MM-dd"))" />
                }
                else
                {
                    <input type="text" class="form-control"
                           value="@(Model.NgaySinh?.ToString("dd/MM/yyyy"))" readonly />
                }
            </div>


            <div class="form-group">
                <label class="form-label">Giới tính</label>
                @if (isEdit)
                {
                    <select id="GioiTinh" class="form-control">
                        <option value="Nam" @(Model.GioiTinh == "Nam" ? "selected" : "" )>Nam</option>
                        <option value="Nữ" @(Model.GioiTinh == "Nữ" ? "selected" : "" )>Nữ</option>
                    </select>
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.GioiTinh" readonly />
                }
            </div>

            <div class="form-group">
                <label class="form-label">Dân tộc</label>
                @if (isEdit)
                {
                    <input type="text" id="DanToc" class="form-control" value="@Model.DanToc" />
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.DanToc" readonly />
                }
            </div>

            <div class="form-group">
                <label class="form-label">Tôn giáo</label>
                @if (isEdit)
                {
                    <input type="text" id="TonGiao" class="form-control" value="@Model.TonGiao" />
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.TonGiao" readonly />
                }
            </div>

            <div class="form-group">
                <label class="form-label">Trường</label>
                <input type="text" class="form-control" value="@Model.Truong" readonly />
            </div>

            <div class="form-group">
                <label class="form-label">Khu phố</label>
                <input type="text" class="form-control" value="@Model.KhuPho" readonly />
            </div>

            <div class="form-group full">
                <label class="form-label">Tình trạng</label>
                @if (isEdit)
                {
                    <input type="text" id="TinhTrang" class="form-control" value="@Model.TinhTrang" />
                }
                else
                {
                    <input type="text" class="form-control" value="@Model.TinhTrang" readonly />
                }
            </div>
        </div>

        <h3 class="section-title">Phụ huynh</h3>
        <div class="form-grid full">
            <table class="styled-table" id="tablePhuHuynh">
                <thead><tr><th>Họ tên</th><th>Quan hệ</th><th>SĐT</th><th>Nghề nghiệp</th></tr></thead>
                <tbody>
                    @foreach (var ph in Model.PhuHuynh)
                    {
                        <tr>
                            <td>@ph.HoTen</td>
                            <td>@ph.MoiQuanHe</td>
                            <td>@ph.Sdt</td>
                            <td>@ph.NgheNghiep</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3 class="section-title">Hoàn cảnh gia đình</h3>
        <div class="form-grid full">
            <p>@string.Join(", ", Model.HoanCanh?.Select(h => h.LoaiHoanCanh) ?? new List<string>())</p>
        </div>
    </div>

    <!-- TAB 2 -->
    <div class="form-step" id="tab2">
        <h3 class="section-title">Học tập</h3>

        @if (isEdit)
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Điểm trung bình</label>
                    <input type="number" step="0.1" class="form-control" id="DiemTrungBinh"
                           value="@(Model.HocTap.FirstOrDefault()?.DiemTrungBinh ?? 0)" />
                </div>

                <div class="form-group">
                    <label>Xếp loại</label>
                    <select id="XepLoai" class="form-control">
                        <option @(Model.HocTap.FirstOrDefault()?.XepLoai == "Giỏi" ? "selected" : "")>Giỏi</option>
                        <option @(Model.HocTap.FirstOrDefault()?.XepLoai == "Khá" ? "selected" : "")>Khá</option>
                        <option @(Model.HocTap.FirstOrDefault()?.XepLoai == "Trung bình" ? "selected" : "")>Trung bình</option>
                        <option @(Model.HocTap.FirstOrDefault()?.XepLoai == "Yếu" ? "selected" : "")>Yếu</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Hạnh kiểm</label>
                    <select id="HanhKiem" class="form-control">
                        <option @(Model.HocTap.FirstOrDefault()?.HanhKiem == "Tốt" ? "selected" : "")>Tốt</option>
                        <option @(Model.HocTap.FirstOrDefault()?.HanhKiem == "Khá" ? "selected" : "")>Khá</option>
                        <option @(Model.HocTap.FirstOrDefault()?.HanhKiem == "Trung bình" ? "selected" : "")>Trung bình</option>
                    </select>
                </div>

                <div class="form-group full">
                    <label>Ghi chú</label>
                    <textarea id="GhiChu" class="form-control">@Model.HocTap.FirstOrDefault()?.GhiChu</textarea>
                </div>
            </div>
        }
        else
        {
            <table class="styled-table">
                <thead><tr><th>Ngày</th><th>Điểm TB</th><th>Xếp loại</th><th>Hạnh kiểm</th><th>Ghi chú</th></tr></thead>
                <tbody>
                    @foreach (var ht in Model.HocTap)
                    {
                        <tr>
                            <td>@(ht.NamHoc.HasValue ? ht.NamHoc.Value.ToString("dd/MM/yyyy") : "-")</td>
                            <td>@ht.DiemTrungBinh</td>
                            <td>@ht.XepLoai</td>
                            <td>@ht.HanhKiem</td>
                            <td>@ht.GhiChu</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>


    <!-- TAB 3 -->
    <div class="form-step" id="tab3">
        <h3 class="section-title">Vận động</h3>
        <table class="styled-table">
            <thead><tr><th>Ngày</th><th>Lý do</th><th>Kết quả</th><th>Số lần</th></tr></thead>
            <tbody>
                @foreach (var v in Model.VanDong)
                {
                    <tr>
                        <td>@v.NgayVanDong</td>
                        <td>@v.LyDo</td>
                        <td>@v.KetQua</td>
                        <td>@v.SoLan</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TAB 4 -->
    <div class="form-step" id="tab4">
        <h3 class="section-title">Hỗ trợ</h3>
        <p>Chưa có hỗ trợ</p>
    </div>

    <!-- NÚT HÀNH ĐỘNG ĐỘNG -->
    <div class="form-actions" id="actionButtons"></div>
</div>

<script>
    let currentStep = 1;
    const totalSteps = 4;
    const isEdit = @isEdit.ToString().ToLower();

    function showStep(step) {
        document.querySelectorAll('.form-step').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
        document.querySelectorAll('.step-item').forEach((s, i) => {
            s.classList.toggle('active', i + 1 === step);
        });
        updateButtons(step);
    }

    function updateButtons(step) {
        const actions = document.getElementById("actionButtons");
        let html = "";

        if (step > 1) {
            html += `
              <button class="btn btn-secondary" type="button" onclick="prevStep()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle;">
                  <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                </svg>
                Quay lại
              </button>
`;
        }

        if (isEdit && (step === 1 || step === totalSteps || (step > 1 && step < totalSteps))) {
            html += `<button class="btn btn-success" type="button" onclick="saveEdit()">   <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>`;
        } else if (!isEdit && step === 1) {
           // html += `<a class="btn btn-primary" href="@Url.Action("ChiTiet","QuanLyTreEm", new { id=Model.TreEmId, edit=true })">✏️ Chỉnh sửa</a>`;
        }

        if (step < totalSteps) {
            html += `
              <button class="btn btn-primary" type="button" onclick="nextStep()">
                Tiếp theo
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-left: 5px;">
                  <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                </svg>
              </button>
`;
        }

        actions.innerHTML = html;
    }

    function nextStep() {
        if (currentStep < totalSteps) {
            currentStep++;
            showStep(currentStep);
        }
    }

    function prevStep() {
        if (currentStep > 1) {
            currentStep--;
            showStep(currentStep);
        }
    }

    document.addEventListener("DOMContentLoaded", () => showStep(currentStep));

  async function saveEdit() {

    const hocTap = [{
        DiemTrungBinh: parseFloat(document.getElementById("DiemTrungBinh")?.value || 0),
        XepLoai: document.getElementById("XepLoai")?.value || "",
        HanhKiem: document.getElementById("HanhKiem")?.value || "",
        GhiChu: document.getElementById("GhiChu")?.value || "",
        LopId: 1
    }];

    const model = {
        HoTen: document.getElementById("HoTen").value,
        NgaySinh: document.getElementById("NgaySinh").value,
        GioiTinh: document.getElementById("GioiTinh").value,
        DanToc: document.getElementById("DanToc").value,
        TonGiao: document.getElementById("TonGiao").value,
        TinhTrang: document.getElementById("TinhTrang").value,
        KhuPhoId: 1,
        TruongId: 1,
        QuocTich: "Việt Nam",
        Anh: document.getElementById("photoPreview").dataset.imagePath || "@Model.Anh",

        HocTaps: hocTap
    };

    const res = await fetch(`https://localhost:44362/api/TreEm/Update/@Model.TreEmId`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(model)
    });

    if (res.ok) {
        alert("🎉 Cập nhật thành công!");
        window.location.href = `/QuanLyTreEm/ChiTiet/@Model.TreEmId`;
    } else {
        alert("❌ Lỗi khi lưu dữ liệu!");
    }
}


    // Xử lý upload ảnh preview
    const photoInput = document.getElementById("photoInput");
    if (photoInput) {
        photoInput.addEventListener("change", (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                const preview = document.getElementById("photoPreview");
                preview.style.backgroundImage = `url(${ev.target.result})`;
                preview.dataset.imagePath = ev.target.result;
            };
            reader.readAsDataURL(file);
        });
    }
</script>
