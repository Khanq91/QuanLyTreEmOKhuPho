@{
    ViewBag.Title = "ThemTreEm_v3";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/ThemTreEm.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/css/media.css" />

<div class="step-container">
    <div class="step-progress">
        <div class="step-item completed"><div class="step-circle"><i class="fa-solid fa-check"></i></div><div class="step-label">Thông tin cơ bản</div></div>
        <div class="step-item completed"><div class="step-circle"><i class="fa-solid fa-check"></i></div><div class="step-label">Phụ huynh</div></div>
        <div class="step-item active"><div class="step-circle">3</div><div class="step-label">Học tập</div></div>
    </div>
</div>

<div class="form-container">
    <h3 class="section-title"><i class="fa-solid fa-graduation-cap"></i> Thông tin học tập</h3>
    <div class="form-grid">
        <div class="form-group"><label>Tên trường</label><input id="tenTruong" class="form-control" /></div>
        <div class="form-group"><label>Tên lớp</label><input id="tenLop" class="form-control" /></div>
        <div class="form-group"><label>Điểm trung bình</label><input id="diemTrungBinh" type="number" step="0.1" class="form-control" /></div>
        <div class="form-group">
            <label>Xếp loại</label>
            <select id="xepLoai" class="form-control"><option>Giỏi</option><option>Khá</option><option>Trung bình</option><option>Yếu</option></select>
        </div>
        <div class="form-group">
            <label>Hạnh kiểm</label>
            <select id="hanhKiem" class="form-control"><option>Tốt</option><option>Khá</option><option>Trung bình</option></select>
        </div>
    </div>

    <div class="form-actions">
        <button class="btn btn-secondary" onclick="window.history.back()"><i class="fa-solid fa-arrow-left"></i> Quay lại</button>
        <div style="flex:1;"></div>
        <button class="btn btn-secondary">Hủy bỏ</button>
        <button class="btn btn-success" type="button" onclick="saveTreEm()"><i class="fa-solid fa-check"></i> Hoàn tất</button>
    </div>
</div>

<script>
    async function saveTreEm() {
        const basic = JSON.parse(localStorage.getItem("TreEm_Basic") || "{}");
        const parents = JSON.parse(localStorage.getItem("TreEm_Parents") || "[]");
        const hocTap = [{
            DiemTrungBinh: parseFloat($("#diemTrungBinh").val()) || 0,
            XepLoai: $("#xepLoai").val(),
            HanhKiem: $("#hanhKiem").val(),
            GhiChu: "",
            LopId: 1
        }];

        const model = {
            HoTen: basic.HoTen,
            NgaySinh: basic.NgaySinh,
            GioiTinh: basic.GioiTinh,
            TonGiao: basic.TonGiao,
            DanToc: basic.DanToc,
            QuocTich: "Việt Nam",
            Anh: basic.Anh,
            TruongId: 1,
            KhuPhoId: parseInt(basic.KhuPhoId) || 1,
            TinhTrang: "Bình thường",
            HoanCanhIds: basic.TinhTrang || [],
            PhuHuynhs: parents,
            HocTaps: hocTap
        };

        try {
            const res = await fetch("https://localhost:44362/api/TreEm/Create", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(model)
            });
            if (res.ok) {
                alert("🎉 Thêm trẻ mới thành công!");
                localStorage.removeItem("TreEm_Basic");
                localStorage.removeItem("TreEm_Parents");
                window.location.href = "/QuanLyTreEm/TreEm";
            } else {
                alert("❌ Lỗi khi lưu dữ liệu!");
            }
        } catch (err) {
            alert("⚠️ Không thể kết nối API!");
            console.error(err);
        }
    }
</script>
