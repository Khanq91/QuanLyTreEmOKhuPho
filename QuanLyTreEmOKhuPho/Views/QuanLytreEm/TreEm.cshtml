@{
    ViewBag.Title = "TreEm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/Content/css/TreEm.css" />
    <link rel="stylesheet" href="~/Content/css/media.css" />
    <title>Quản Lý Trẻ Em - Hệ Thống Quản Lý Khu Phố</title>
</head>

<body>
    <div class="filter-section">
        <div class="filter-header">
            <h3 class="filter-title"><i class="fa-solid fa-magnifying-glass"></i> Bộ lọc tìm kiếm</h3>
            <button class="btn btn-primary btn-sm" onclick="applyFilters()">Áp dụng</button>
        </div>
        <div class="filter-grid">
            <div class="form-group search-bar">
                <label class="form-label">Tìm kiếm</label>
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" class="form-control" placeholder="Tìm theo tên, ID..." id="searchInput">
            </div>
            <div class="form-group">
                <label class="form-label">Hoàn cảnh gia đình</label>
                <select class="form-control" id="filterHoanCanh">
                    <option value="">Tất cả</option>
                    <option value="Mồ côi">Mồ côi</option>
                    <option value="Hộ nghèo">Hộ nghèo</option>
                    <option value="Khuyết tật">Khuyết tật</option>
                    <option value="Khó khăn">Khó khăn</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Khu phố</label>
                <select class="form-control" id="filterKhuPho">
                    <option value="">Tất cả khu phố</option>
                    <option value="1">Khu phố 1</option>
                    <option value="2">Khu phố 2</option>
                    <option value="3">Khu phố 3</option>
                    <option value="4">Khu phố 4</option>
                    <option value="5">Khu phố 5</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Giới tính</label>
                <select class="form-control" id="filterGender">
                    <option value="">Tất cả</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                </select>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header">
            <h3 class="table-title">Danh sách trẻ em (<span id="totalChildren">0</span>)</h3>
            <div class="table-actions">
                <button class="btn-icon"><i class="fa-solid fa-chart-area"></i></button>
                <button class="btn-icon"><i class="fa-solid fa-print"></i></button>
                <a href="@Url.Action("ThemTreEm_v1", "QuanLyTreEm")" class="btn btn-primary">
                    <i class="fa-solid fa-circle-plus"></i> Thêm trẻ em mới
                </a>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Thông tin trẻ</th>
                    <th>Khu phố</th>
                    <th>Hoàn cảnh</th>
                    <th>Trường học</th>
                    <th>Tình trạng</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="childrenTableBody"></tbody>
        </table>

        <div class="pagination">
            <div class="pagination-info">Hiển thị <strong id="paginationInfo">0</strong> trẻ em</div>
        </div>
    </div>

    <div class="modal" id="childDetailModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Chi tiết hồ sơ trẻ em</h3>
                <button class="close-btn" onclick="closeModal()">✕</button>
            </div>
            <div class="modal-body">
                <p>Thông tin chi tiết trẻ em sẽ hiển thị ở đây</p>
            </div>
        </div>
    </div>

    <script>
        let allChildren = [];

        // ==============================
        // 1️⃣ Load dữ liệu từ API
        // ==============================
        async function loadChildren() {
            try {
                const response = await fetch("https://localhost:44362/api/TreEm/DanhSach");
                if (!response.ok) throw new Error("Không thể tải dữ liệu từ API");
                allChildren = await response.json();
                renderTable(allChildren);
                showNotification(`Tải thành công ${allChildren.length} trẻ em`, 'success');
            } catch (error) {
                console.error(error);
                showNotification("Lỗi khi tải danh sách trẻ em", 'danger');
            }
        }

        // ==============================
        // 2️⃣ Render bảng
        // ==============================
        function renderTable(data) {
            const tbody = document.getElementById('childrenTableBody');
            tbody.innerHTML = '';
            data.forEach(child => {
                const hoanCanhText = child.hoanCanh && child.hoanCanh.length > 0
                    ? child.hoanCanh.join(', ')
                    : 'Không có';
                const img = child.anh || '/Anh/default-avatar.png';
                const genderClass = child.gioiTinh === 'Nam' ? 'male' : 'female';

                const row = `
                            <tr>
                                <td style="font-weight: 600; color: var(--primary);">${child.treEmId}</td>
                                <td>
                                    <div class="child-info">

                                          <div class="child-avatar ${genderClass}">
                <img src="${child.anh || '/images/treem/default-child.png'}"
                     alt="${child.hoTen}"
                     style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;">
            </div>
                                        <div class="child-details">
                                            <h4>${child.hoTen}</h4>
                                            <p>${child.gioiTinh}</p>
                                        </div>
                                    </div>
                                </td>
                                <td>${child.khuPho}</td>
                                <td>${hoanCanhText}</td>
                                <td>${child.truong || '—'}</td>
                                <td>${child.tinhTrang || '—'}</td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn btn-sm btn-view" onclick="location.href='/QuanLyTreEm/ChiTiet/' + ${child.treEmId}">Xem</button>
                                        <button class="btn btn-sm btn-edit" onclick="editChild(${child.treEmId})">Sửa</button>
                                        <button class="btn btn-sm btn-delete" onclick="deleteChild(${child.treEmId})">Xóa</button>
                                    </div>
                                </td>
                            </tr>`;
                tbody.insertAdjacentHTML('beforeend', row);
            });

            document.getElementById('totalChildren').textContent = data.length;
            document.getElementById('paginationInfo').textContent = data.length;
        }

        // ==============================
        // 3️⃣ Bộ lọc client
        // ==============================
        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const khuPho = document.getElementById('filterKhuPho').value;
            const gender = document.getElementById('filterGender').value;
            const hoanCanh = document.getElementById('filterHoanCanh').value.toLowerCase();


            const filtered = allChildren.filter(c => {
                const matchSearch = !search || c.hoTen.toLowerCase().includes(search);
                const matchKhuPho = !khuPho || c.khuPho.includes(khuPho);
                const matchGender = !gender || c.gioiTinh === gender;
                const matchHoanCanh = !hoanCanh || (c.hoanCanh && c.hoanCanh.join(',').toLowerCase().includes(hoanCanh));

                return matchSearch && matchKhuPho && matchGender && matchHoanCanh;
            });

            renderTable(filtered);
            showNotification(`Tìm thấy ${filtered.length} trẻ em`, 'info');
        }

        document.getElementById('searchInput').addEventListener('input', applyFilters);

        // ==============================
        // 4️⃣ Xem / Sửa / Xóa
        // ==============================
        async function viewChild(id) {
            const modal = document.getElementById('childDetailModal');
            const modalBody = modal.querySelector('.modal-body');
            modal.classList.add('active');
            modalBody.innerHTML = `<p style="text-align:center;">⏳ Đang tải dữ liệu...</p>`;

            try {
                const res = await fetch(`https://localhost:44362/api/TreEm/${id}`);
                if (!res.ok) throw new Error("Không thể tải dữ liệu chi tiết");
                const data = await res.json();

                const imgUrl = data.anh?.replace(/\\/g, "/") || "/Anh/default-avatar.png";

                // Render nội dung chi tiết vào modal
                modalBody.innerHTML = `
                <div class="child-detail">
                    <div class="child-header">
                        <img src="${imgUrl}" class="child-avatar-modal" />
                        <div>
                            <h3 style="margin:0;color:var(--primary)">${data.hoTen}</h3>
                            <p>${data.gioiTinh} • ${new Date(data.ngaySinh).toLocaleDateString("vi-VN")}</p>
                            <span class="badge badge-info">${data.tinhTrang}</span>
                        </div>
                    </div>

                    <div class="child-info">
                        <p><strong>Khu phố:</strong> ${data.khuPho}</p>
                        <p><strong>Trường học:</strong> ${data.truong}</p>
                        <p><strong>Tôn giáo:</strong> ${data.tonGiao}</p>
                        <p><strong>Dân tộc:</strong> ${data.danToc}</p>
                        <p><strong>Quốc tịch:</strong> ${data.quocTich}</p>
                    </div>

                    <div class="child-section">
                        <h4><i class="fa-solid fa-heart"></i> Hoàn cảnh</h4>
                        <p>${data.hoanCanh?.length ? data.hoanCanh.join(', ') : 'Không có'}</p>
                    </div>

                    <div class="child-section">
                        <h4><i class="fa-solid fa-people-roof"></i> Phụ huynh</h4>
                        ${data.phuHuynh?.length
                        ? `<table class="detail-table"><tr><th>Tên</th><th>SĐT</th><th>Nghề nghiệp</th><th>Quan hệ</th></tr>` +
                        data.phuHuynh.map(p => `
                                <tr>
                                    <td>${p.hoTen}</td>
                                    <td>${p.sdt || ''}</td>
                                    <td>${p.ngheNghiep || ''}</td>
                                    <td>${p.moiQuanHe || ''}</td>
                                </tr>`).join('') +
                        `</table>`
                        : '<p class="text-muted">Không có thông tin phụ huynh</p>'
                    }
                    </div>

                    <div class="child-section">
                        <h4><i class="fa-solid fa-school"></i> Học tập</h4>
                        ${data.hocTap?.length
                        ? `<table class="detail-table"><tr><th>Ngày</th><th>Điểm TB</th><th>Xếp loại</th><th>Hạnh kiểm</th><th>Ghi chú</th></tr>` +
                        data.hocTap.map(h => `
                                <tr>
                                    <td>${new Date(h.ngayCapNhat).toLocaleDateString("vi-VN")}</td>
                                    <td>${h.diemTrungBinh}</td>
                                    <td>${h.xepLoai}</td>
                                    <td>${h.hanhKiem}</td>
                                    <td>${h.ghiChu || ''}</td>
                                </tr>`).join('') +
                        `</table>`
                        : '<p class="text-muted">Chưa có dữ liệu học tập</p>'
                    }
                    </div>

                    <div class="child-section">
                        <h4><i class="fa-solid fa-hand-holding-heart"></i> Hỗ trợ phúc lợi</h4>
                        ${data.hoTro?.length
                        ? data.hoTro.map(ht => `
                                <div class="support-item">
                                    🎁 <strong>${ht.loaiHoTro}</strong> — ${ht.moTa}<br/>
                                    📅 Ngày cấp: ${new Date(ht.ngayCap).toLocaleDateString("vi-VN")}<br/>
                                    ${ht.file?.length
                                ? `<small>File: ${ht.file.join(', ')}</small>`
                                : ''
                            }
                                </div>
                            `).join('')
                        : '<p class="text-muted">Chưa có hỗ trợ phúc lợi</p>'
                    }
                    </div>

                    <div class="child-section">
                        <h4><i class="fa-solid fa-handshake-angle"></i> Vận động hỗ trợ</h4>
                        ${data.vanDong?.length
                        ? data.vanDong.map(v => `
                                <div class="support-item">
                                    🔄 ${new Date(v.ngayVanDong).toLocaleDateString("vi-VN")} — <strong>${v.lyDo}</strong>
                                    <br/>✅ Kết quả: ${v.ketQua}
                                </div>
                            `).join('')
                        : '<p class="text-muted">Chưa có dữ liệu vận động</p>'
                    }
                    </div>
                </div>
            `;
            } catch (error) {
                console.error(error);
                modalBody.innerHTML = `<p class="text-danger">❌ Lỗi khi tải dữ liệu chi tiết</p>`;
            }
        }


        function editChild(id) {
            window.location.href = `/QuanLyTreEm/ChiTiet/${id}?edit=true`;
        }
        async function deleteChild(id) {
            debugger
            if (confirm(`Bạn có chắc muốn xóa trẻ ID = ${id}?`)) {
                const res = await fetch(`https://localhost:44362/api/TreEm/Delete/${id}`, { method: 'POST' });
                if (res.ok) {
                    showNotification('Đã xóa trẻ thành công', 'success');
                    loadChildren();
                } else {
                    showNotification('Xóa thất bại', 'danger');
                }
            }
        }


        // ==============================
        // 5️⃣ Modal & Notification
        // ==============================
        function closeModal() {
            document.getElementById('childDetailModal').classList.remove('active');
        }

        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            const icons = { success: '✓', warning: '⚠', info: 'ℹ', danger: '✕' };
            const colors = {
                success: 'var(--success)',
                warning: 'var(--warning)',
                info: 'var(--primary)',
                danger: 'var(--danger)'
            };

            notification.innerHTML = `
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <span style="font-size: 20px;">${icons[type]}</span>
                            <span>${message}</span>
                        </div>`;
            notification.style.cssText = `
                        position: fixed;
                        top: 20px;
                        right: 20px;
                        background: white;
                        padding: 16px 24px;
                        border-radius: 12px;
                        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
                        z-index: 10000;
                        border-left: 4px solid ${colors[type]};
                        animation: fadeIn 0.3s ease;
                    `;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 3000);
        }

        // ==============================
        // 6️⃣ Khởi tạo
        // ==============================
        loadChildren();
    </script>
    <style>
        .child-detail {
            max-height: 80vh;
            overflow-y: auto;
            padding-right: 10px;
        }

        .child-avatar-modal {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            margin-right: 12px;
            border: 2px solid var(--primary);
            object-fit: cover;
        }

        .child-header {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            gap: 15px;
        }

        .child-section {
            margin-top: 20px;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }

        .detail-table {
            width: 100%;
            border-collapse: collapse;
        }

            .detail-table th, .detail-table td {
                border: 1px solid #ddd;
                padding: 6px 8px;
                font-size: 14px;
            }
    </style>
</body>
</html>
