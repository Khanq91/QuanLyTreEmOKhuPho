
@{
    ViewBag.Title = "SuaThongTinTaiKhoan";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var TTNguoiDung = ViewBag.TTNguoiDung;
}
<link rel="stylesheet" href="~/Content/css/Site.css" />
<link rel="stylesheet" href="~/Content/css/taotaikhoan.css" />
<div class="back-button">
    <a href="@Url.Action("QuanLyTaiKhoan", "QuanLyTaiKhoan")" class="btn-back">
        <i class="fa-solid fa-arrow-left"></i> Quay lại
    </a>
</div>
<div class="card">
    <style>
        .alert.success {
            background-color: #4CAF50;
            border: 1px solid #4CAF50;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
        }

        .alert.error {
            background-color: #f44336;
            border: 1px solid #f44336;
            color: white;
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
        }

        .table-container {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #ddd;
            border-radius: 5px;
            margin: 20px 0;
        }

        #previewTable {
            width: 100%;
            border-collapse: collapse;
        }

            #previewTable th {
                background-color: #2196F3;
                color: white;
                padding: 12px;
                text-align: left;
                position: sticky;
                top: 0;
                z-index: 10;
            }

            #previewTable td {
                padding: 10px;
                border-bottom: 1px solid #ddd;
            }

            #previewTable tbody tr:hover {
                background-color: #f5f5f5;
            }

            #previewTable .error-row {
                background-color: #ffebee !important;
            }

            #previewTable .error-cell {
                color: #d32f2f;
                font-weight: bold;
            }

            #previewTable .status-valid {
                color: #4CAF50;
                font-weight: bold;
            }

            #previewTable .status-error {
                color: #f44336;
                font-weight: bold;
            }

        .loading {
            display: none;
            text-align: center;
            padding: 20px;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #2196F3;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 10px;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .file-upload-area {
            border: 2px dashed #ccc;
            border-radius: 8px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .file-upload-area:hover {
                border-color: #2196F3;
                background-color: #f5f5f5;
            }

            .file-upload-area.dragover {
                border-color: #4CAF50;
                background-color: #E8F5E9;
            }

        .file-name {
            margin: 15px 0;
            padding: 10px;
            background-color: #E3F2FD;
            border-radius: 5px;
            color: #1976D2;
            font-weight: bold;
        }

        .validation-summary {
            margin: 15px 0;
            padding: 15px;
            border-radius: 5px;
            background-color: #fff3cd;
            border: 1px solid #ffc107;
        }

            .validation-summary h4 {
                margin: 0 0 10px 0;
                color: #856404;
            }

            .validation-summary ul {
                margin: 0;
                padding-left: 20px;
            }

            .validation-summary li {
                color: #856404;
                margin: 5px 0;
            }

        .back-button {
            margin-bottom: 10px;
        }

        .btn-back {
            display: inline-block;
            background-color: #f0f0f0;
            color: #333;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
            transition: background-color 0.2s ease;
        }
    </style>
    <!-- Tab 1: Tạo thủ công -->
    <div id="manualTab" class="tab-content active">
        <form id="manualForm" method="post" action="@Url.Action("SuaThongTinTaiKhoan","QuanLyTaiKhoan")">
            <input type="hidden" name="UserId" value="@TTNguoiDung.UserId" />
            <div class="form-grid">
                <div class="form-group">
                    <label>Họ và tên <span class="required">*</span></label>
                    <input type="text" name="HoTen" id="hoTen" placeholder="Nhập họ tên đầy đủ" required value=" @TTNguoiDung.HoTen">
                </div>
                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <input type="email" name="Email" placeholder="email@example.com" required value="@TTNguoiDung.Email">
                </div>
                <div class="form-group">
                    <label>Số điện thoại <span class="required">*</span></label>
                    <input type="tel" name="SDT" placeholder="0xxxxxxxxx" pattern="0\d{9}" maxlength="10" required value="@TTNguoiDung.SDT">
                </div>
                <div class="form-group">
                    <label>Vai trò <span class="required">*</span></label>
                    <select name="VaiTro" class="form-control" required>
                        <option value="">-- Chọn vai trò --</option>
                        <option value="Cán bộ" @(TTNguoiDung.VaiTro == "Cán bộ" ? "selected" : "")>Cán bộ</option>
                        <option value="Tình nguyện viên" @(TTNguoiDung.VaiTro == "Tình nguyện viên" ? "selected" : "")>Tình nguyện viên</option>
                        <option value="Phụ huynh" @(TTNguoiDung.VaiTro == "Phụ huynh" ? "selected" : "")>Phụ huynh</option>
                    </select>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert error">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">✅ Lưu thay đổi</button>
            </div>
        </form>
    </div>

</div>

