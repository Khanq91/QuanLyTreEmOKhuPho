@{
    ViewBag.Title = "TaoTaiKhoan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model QuanLyTreEmOKhuPho.Models.QuanLyTaiKhoan.TaoTaiKhoan
<link rel="stylesheet" href="~/Content/css/Site.css" />
<link rel="stylesheet" href="~/Content/css/taotaikhoan.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
    .alert.success {
        background-color: #4CAF50;
        border: 1px solid #4CAF50;
        color: white;
        padding: 15px;
        border-radius: 5px;
        margin: 10px 0;
    }

    .alert.error {
        background-color: #f44336;
        border: 1px solid #f44336;
        color: white;
        padding: 15px;
        border-radius: 5px;
        margin: 10px 0;
    }

    .table-container {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #ddd;
        border-radius: 5px;
        margin: 20px 0;
    }

    #previewTable {
        width: 100%;
        border-collapse: collapse;
    }

        #previewTable th {
            background-color: #2196F3;
            color: white;
            padding: 12px;
            text-align: left;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        #previewTable td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        #previewTable tbody tr:hover {
            background-color: #f5f5f5;
        }

        #previewTable .error-row {
            background-color: #ffebee !important;
        }

        #previewTable .error-cell {
            color: #d32f2f;
            font-weight: bold;
        }

        #previewTable .status-valid {
            color: #4CAF50;
            font-weight: bold;
        }

        #previewTable .status-error {
            color: #f44336;
            font-weight: bold;
        }

    .loading {
        display: none;
        text-align: center;
        padding: 20px;
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #2196F3;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 10px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .file-upload-area {
        border: 2px dashed #ccc;
        border-radius: 8px;
        padding: 40px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
    }

        .file-upload-area:hover {
            border-color: #2196F3;
            background-color: #f5f5f5;
        }

        .file-upload-area.dragover {
            border-color: #4CAF50;
            background-color: #E8F5E9;
        }

    .file-name {
        margin: 15px 0;
        padding: 10px;
        background-color: #E3F2FD;
        border-radius: 5px;
        color: #1976D2;
        font-weight: bold;
    }

    .validation-summary {
        margin: 15px 0;
        padding: 15px;
        border-radius: 5px;
        background-color: #fff3cd;
        border: 1px solid #ffc107;
    }

        .validation-summary h4 {
            margin: 0 0 10px 0;
            color: #856404;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        .validation-summary li {
            color: #856404;
            margin: 5px 0;
        }
</style>

<div class="card">
    <div class="tabs">
        <button class="tab active" onclick="switchTab('manual')">
            ✍️ Tạo thủ công
        </button>
        <button class="tab" onclick="switchTab('import')">
            📁 Import từ Excel
        </button>
    </div>

    <!-- Tab 1: Tạo thủ công -->
    <div id="manualTab" class="tab-content active">
        <div class="alert alert-info">
            <span>ℹ️</span>
            <div>
                <strong>Lưu ý:</strong> Mật khẩu mặc định là <code>140letrongtan</code> nếu bạn không nhập mật khẩu tùy chỉnh.
            </div>
        </div>

        <form id="manualForm" method="post" action="@Url.Action("TaoTaiKhoan","QuanLyTaiKhoan")">
            <div class="form-grid">
                <div class="form-group">
                    <label>Họ và tên <span class="required">*</span></label>
                    <input type="text"
                           name="HoTen"
                           id="hoTen"
                           placeholder="Nhập họ tên đầy đủ"
                           value="@(Model?.HoTen ?? "")"
                           required>
                </div>

                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <input type="email"
                           name="Email"
                           placeholder="email@example.com"
                           value="@(Model?.Email ?? "")"
                           required>
                </div>

                <div class="form-group">
                    <label>Số điện thoại <span class="required">*</span></label>
                    <input type="tel"
                           name="SDT"
                           placeholder="0xxxxxxxxx"
                           pattern="0\d{9}"
                           maxlength="10"
                           value="@(Model?.SDT ?? "")"
                           required>
                </div>

                <div class="form-group">
                    <label>Vai trò <span class="required">*</span></label>
                    <select name="VaiTro" required>
                        <option value="">-- Chọn vai trò --</option>
                        <option value="Cán bộ" @(Model?.VaiTro == "Cán bộ" ? "selected" : "")>Cán bộ</option>
                        <option value="Tình nguyện viên" @(Model?.VaiTro == "Tình nguyện viên" ? "selected" : "")>Tình nguyện viên</option>
                        <option value="Phụ huynh" @(Model?.VaiTro == "Phụ huynh" ? "selected" : "")>Phụ huynh</option>
                    </select>
                </div>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert success">@ViewBag.Message</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert error">@ViewBag.Error</div>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="resetForm()">🔄 Làm mới</button>
                <button type="submit" class="btn btn-primary">✅ Tạo tài khoản</button>
            </div>
        </form>
    </div>
    <!-- Tab 2: Import Excel -->
    <div id="importTab" class="tab-content">
        <div class="alert alert-info">
            <span>ℹ️</span>
            <div>
                <strong>Hướng dẫn:</strong> File Excel cần có các cột: <strong>HoTen, Email, SDT, VaiTro, MatKhau</strong>
                <br>Vai trò: <code>Cán bộ</code>, <code>Tình nguyện viên</code>, <code>Phụ huynh</code>
                <br>mật khẩu mặc định <strong>140letrongtan</strong>
            </div>
        </div>

        @if (ViewBag.ImportMessage != null)
        {
            <div class="alert success">@ViewBag.ImportMessage</div>
        }
        @if (ViewBag.ImportError != null)
        {
            <div class="alert alert-danger">
                @Html.Raw(ViewBag.ImportError)
            </div>
        }


        <div style="margin-bottom: 20px;">
            <button class="btn btn-outline" onclick="downloadTemplate()" id="filemau">
                📄 Tải file mẫu
            </button>
        </div>

        <form id="importForm" method="post" action="@Url.Action("ImportExcel","QuanLyTaiKhoan")" enctype="multipart/form-data">
            <div class="file-upload-area" id="dropArea" onclick="document.getElementById('fileInput').click()">
                <input type="file" id="fileInput" name="excelFile" accept=".xlsx,.xls" style="display: none;" onchange="handleFileSelect(event)">
                <div class="file-upload-icon" style="font-size: 48px;">📁</div>
                <h3>Chọn file Excel để import</h3>
                <p style="color: #666; margin-top: 10px;">Kéo thả file vào đây hoặc nhấp để chọn</p>
            </div>

            <div id="fileNameDisplay" class="file-name" style="display: none;"></div>

            <div id="validationSummary" class="validation-summary" style="display: none;">
                <h4>⚠️ Cảnh báo lỗi dữ liệu</h4>
                <ul id="validationList"></ul>
            </div>

            <div id="importPreview" style="display: none;">
                <h4 style="margin: 20px 0 15px; color: #333;">
                    📋 Xem trước dữ liệu
                    (<span id="rowCount">0</span> dòng -
                    <span id="validCount" style="color: #4CAF50;">0 hợp lệ</span>,
                    <span id="errorCount" style="color: #f44336;">0 lỗi</span>)
                </h4>
                <div class="table-container">
                    <table id="previewTable">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>SĐT</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="previewBody"></tbody>
                    </table>
                </div>

                <input type="hidden" id="validDataJson" name="validDataJson" />

                <div class="form-actions">
                    <button type="button" class="btn btn-outline" onclick="cancelImport()">❌ Hủy</button>
                    <button type="submit" id="submitBtn" class="btn btn-success">📥 Xác nhận Import</button>
                </div>
            </div>
        </form>

        <div id="loadingImport" class="loading">
            <div class="spinner"></div>
            <p>Đang đọc file...</p>
        </div>
    </div>
</div>

<script>
    let validatedData = [];
    function switchTab(tabName) {
        document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

        if (tabName === 'manual') {
            document.querySelector('.tab:nth-child(1)').classList.add('active');
            document.getElementById('manualTab').classList.add('active');
        } else {
            document.querySelector('.tab:nth-child(2)').classList.add('active');
            document.getElementById('importTab').classList.add('active');

            if (validatedData.length > 0) {
                document.getElementById('importPreview').style.display = 'block';
            }
        }
    }


    function resetForm() {
        document.getElementById('manualForm').reset();
    }

    // Drag & Drop
    const dropArea = document.getElementById('dropArea');

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => dropArea.classList.add('dragover'), false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => dropArea.classList.remove('dragover'), false);
    });

    dropArea.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0) {
            document.getElementById('fileInput').files = files;
            handleFileSelect({ target: { files: files } });
        }
    }

    // Validation functions
    function validateEmail(email) {
        const re = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        return re.test(String(email).toLowerCase());
    }

    function validatePhone(phone) {
        const re = /^0\d{9}$/;
        return re.test(String(phone));
    }

    function validateRole(role) {
        const validRoles = ['Cán bộ', 'Tình nguyện viên', 'Phụ huynh'];
        return validRoles.includes(role);
    }

    // Đọc và hiển thị Excel
    function handleFileSelect(event) {
        const file = event.target.files[0];
        if (!file) return;

        document.getElementById('fileNameDisplay').textContent = '📄 ' + file.name;
        document.getElementById('fileNameDisplay').style.display = 'block';

        document.getElementById('loadingImport').style.display = 'block';
        document.getElementById('importPreview').style.display = 'none';
        document.getElementById('validationSummary').style.display = 'none';

        const reader = new FileReader();

        reader.onload = function (e) {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                const jsonData = XLSX.utils.sheet_to_json(firstSheet);

                displayPreview(jsonData);
            } catch (error) {
                alert('Lỗi đọc file: ' + error.message);
            } finally {
                document.getElementById('loadingImport').style.display = 'none';
            }
        };

        reader.onerror = function () {
            alert('Lỗi đọc file!');
            document.getElementById('loadingImport').style.display = 'none';
        };

        reader.readAsArrayBuffer(file);
    }

    // Hiển thị dữ liệu lên bảng với validation
    function displayPreview(data) {
        const tbody = document.getElementById('previewBody');
        const validationList = document.getElementById('validationList');
        tbody.innerHTML = '';
        validationList.innerHTML = '';

        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px;">Không có dữ liệu trong file</td></tr>';
            return;
        }

        validatedData = [];
        let validCount = 0;
        let errorCount = 0;
        const emails = new Set();
        const phones = new Set();
        const errors = [];

        data.forEach((row, index) => {
            const rowNum = index + 1;
            const tr = tbody.insertRow();
            let hasError = false;
            const rowErrors = [];

            // Lấy dữ liệu
            const hoTen = (row.HoTen || row.hoTen || '').toString().trim();
            const email = (row.Email || row.email || '').toString().trim();
            const sdt = String(row.SDT || row.sdt || '').trim().replace(/'/g, '');
            const vaiTro = (row.VaiTro || row.vaiTro || '').toString().trim();

            // Validation
            // 1. Kiểm tra trống
            if (!hoTen) {
                rowErrors.push('Họ tên trống');
                hasError = true;
            }
            if (!email) {
                rowErrors.push('Email trống');
                hasError = true;
            }
            if (!sdt) {
                rowErrors.push('SĐT trống');
                hasError = true;
            }
            if (!vaiTro) {
                rowErrors.push('Vai trò trống');
                hasError = true;
            }

            // 2. Kiểm tra định dạng email
            if (email && !validateEmail(email)) {
                rowErrors.push('Email không hợp lệ');
                hasError = true;
            }

            // 3. Kiểm tra email trùng
            if (email && emails.has(email.toLowerCase())) {
                rowErrors.push('Email bị trùng');
                hasError = true;
            } else if (email) {
                emails.add(email.toLowerCase());
            }

            // 4. Kiểm tra định dạng SĐT
            if (sdt && !validatePhone(sdt)) {
                rowErrors.push('SĐT không hợp lệ (phải là 10 số, bắt đầu bằng 0)');
                hasError = true;
            }

            // 5. Kiểm tra SĐT trùng
            if (sdt && phones.has(sdt)) {
                rowErrors.push('SĐT bị trùng');
                hasError = true;
            } else if (sdt) {
                phones.add(sdt);
            }

            // 6. Kiểm tra vai trò hợp lệ
            if (vaiTro && !validateRole(vaiTro)) {
                rowErrors.push('Vai trò không hợp lệ');
                hasError = true;
            }

            // Thêm class error nếu có lỗi
            if (hasError) {
                tr.classList.add('error-row');
                errorCount++;
                errors.push(`Dòng ${rowNum}: ${rowErrors.join(', ')}`);
            } else {
                validCount++;
                validatedData.push({
                    HoTen: hoTen,
                    Email: email,
                    SDT: sdt,
                    VaiTro: vaiTro,
                });
            }

            tr.insertCell(0).textContent = rowNum;

            // Họ tên
            const hoTenCell = tr.insertCell(1);
            hoTenCell.textContent = hoTen || '(Trống)';
            if (!hoTen) hoTenCell.classList.add('error-cell');

            // Email
            const emailCell = tr.insertCell(2);
            emailCell.textContent = email || '(Trống)';
            if (!email || !validateEmail(email) || (email && emails.size !== new Set([...emails].filter(e => e === email.toLowerCase())).size && emails.has(email.toLowerCase()))) {
                emailCell.classList.add('error-cell');
            }

            // SĐT
            const sdtCell = tr.insertCell(3);
            sdtCell.textContent = sdt || '(Trống)';
            if (!sdt || !validatePhone(sdt)) {
                sdtCell.classList.add('error-cell');
            }

            // Vai trò
            const vaiTroCell = tr.insertCell(4);
            vaiTroCell.textContent = vaiTro || '(Trống)';
            if (!vaiTro || !validateRole(vaiTro)) {
                vaiTroCell.classList.add('error-cell');
            }

            // Trạng thái
            const statusCell = tr.insertCell(5);
            if (hasError) {
                statusCell.innerHTML = '<span class="status-error">❌ Lỗi</span>';
            } else {
                statusCell.innerHTML = '<span class="status-valid">✅ Hợp lệ</span>';
            }

        });

        // Hiển thị tổng kết
        document.getElementById('rowCount').textContent = data.length;
        document.getElementById('validCount').textContent = validCount;
        document.getElementById('errorCount').textContent = errorCount;

        // Hiển thị danh sách lỗi
        if (errors.length > 0) {
            errors.forEach(error => {
                const li = document.createElement('li');
                li.textContent = error;
                validationList.appendChild(li);
            });
            document.getElementById('validationSummary').style.display = 'block';
        }

        // Lưu dữ liệu hợp lệ vào hidden input
        document.getElementById('validDataJson').value = JSON.stringify(validatedData);

        // Disable nút submit nếu có lỗi
        const submitBtn = document.getElementById('submitBtn');
        if (errorCount > 0) {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            submitBtn.style.cursor = 'not-allowed';
            submitBtn.title = 'Vui lòng sửa các lỗi trước khi import';
        } else {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
            submitBtn.title = '';
        }

        document.getElementById('importPreview').style.display = 'block';
        document.getElementById('filemau').style.display = 'none';
        document.getElementById('dropArea').style.display = 'none';
    }
    function cancelImport() {
        document.getElementById('importPreview').style.display = 'none';
        document.getElementById('fileNameDisplay').style.display = 'none';
        document.getElementById('validationSummary').style.display = 'none';
        document.getElementById('fileInput').value = '';
        document.getElementById('previewBody').innerHTML = '';
        validatedData = [];
        document.getElementById('filemau').style.display = 'block';
        document.getElementById('dropArea').style.display = 'block';
    }

    function downloadTemplate() {
        const template = [
            ['HoTen', 'Email', 'SDT', 'VaiTro'],
            ['Nguyễn Văn A', 'nguyenvana@example.com', '0912345678', 'Cán bộ'],
            ['Trần Thị B', 'tranthib@example.com', '0987654321', 'Tình nguyện viên'],
            ['Lê Văn C', 'levanc@example.com', '0901234567', 'Phụ huynh']
        ];

        const ws = XLSX.utils.aoa_to_sheet(template);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, 'TaiKhoan');
        XLSX.writeFile(wb, 'MauImportTaiKhoan.xlsx');
    }
</script>
<script>
    // Thêm vào cuối script trong View TaoTaiKhoan.cshtml

// Khôi phục dữ liệu khi có lỗi hoặc thành công
window.addEventListener('DOMContentLoaded', function() {
    // Kiểm tra xem có dữ liệu cần khôi phục không
    var preservedData = '@Html.Raw(ViewBag.PreservedData ?? "")';
    var preservedFileName = '@(ViewBag.PreservedFileName ?? "")';
    var importMessage = '@(ViewBag.ImportMessage ?? "")';
    var importError = '@Html.Raw(ViewBag.ImportError ?? "")';

    // Nếu có bất kỳ thông báo gì từ Import (lỗi hoặc thành công), chuyển sang tab Import
    if (preservedData !== '' || importMessage !== '' || importError !== '') {
        // Chuyển sang tab Import
        switchTab('import');
    }

    if (preservedData && preservedData !== '') {
        // Hiển thị tên file nếu có
        if (preservedFileName && preservedFileName !== '') {
            document.getElementById('fileNameDisplay').textContent = '📄 ' + preservedFileName;
            document.getElementById('fileNameDisplay').style.display = 'block';
        }

        try {
            // Parse dữ liệu đã validate
            var data = JSON.parse(preservedData);

            if (data && data.length > 0) {
                // Gọi lại hàm displayPreview với dữ liệu đã có
                displayPreview(data);

                // Ẩn dropArea và hiển thị preview
                document.getElementById('dropArea').style.display = 'none';
                document.getElementById('filemau').style.display = 'none';
            }
        } catch (e) {
            console.error('Lỗi khôi phục dữ liệu:', e);
        }
    }

    // Nếu có thông báo import thành công, reset toàn bộ sau 3 giây
    if (importMessage && importMessage !== '') {
        setTimeout(function() {
            cancelImport();
        }, 3000);
    }
});

// Cập nhật hàm cancelImport để reset ViewBag
function cancelImport() {
    document.getElementById('importPreview').style.display = 'none';
    document.getElementById('fileNameDisplay').style.display = 'none';
    document.getElementById('validationSummary').style.display = 'none';
    document.getElementById('fileInput').value = '';
    document.getElementById('previewBody').innerHTML = '';
    document.getElementById('validDataJson').value = '';
    validatedData = [];
    document.getElementById('filemau').style.display = 'block';
    document.getElementById('dropArea').style.display = 'block';

    // Xóa các alert message
    var alerts = document.querySelectorAll('.alert');
    alerts.forEach(function(alert) {
        if (!alert.classList.contains('alert-info')) {
            alert.remove();
        }
    });
}

// Cải tiến hàm displayPreview để hỗ trợ dữ liệu từ server
function displayPreview(data) {
    const tbody = document.getElementById('previewBody');
    const validationList = document.getElementById('validationList');
    tbody.innerHTML = '';
    validationList.innerHTML = '';

    if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px;">Không có dữ liệu trong file</td></tr>';
        return;
    }

    validatedData = [];
    let validCount = 0;
    let errorCount = 0;
    const emails = new Set();
    const phones = new Set();
    const errors = [];

    data.forEach((row, index) => {
        const rowNum = index + 1;
        const tr = tbody.insertRow();
        let hasError = false;
        const rowErrors = [];

        // Lấy dữ liệu - hỗ trợ cả data từ Excel và từ server
        const hoTen = (row.HoTen || row.hoTen || '').toString().trim();
        const email = (row.Email || row.email || '').toString().trim();
        const sdt = String(row.SDT || row.sdt || '').trim().replace(/'/g, '');
        const vaiTro = (row.VaiTro || row.vaiTro || '').toString().trim();

        // Validation
        if (!hoTen) {
            rowErrors.push('Họ tên trống');
            hasError = true;
        }
        if (!email) {
            rowErrors.push('Email trống');
            hasError = true;
        }
        if (!sdt) {
            rowErrors.push('SĐT trống');
            hasError = true;
        }
        if (!vaiTro) {
            rowErrors.push('Vai trò trống');
            hasError = true;
        }

        if (email && !validateEmail(email)) {
            rowErrors.push('Email không hợp lệ');
            hasError = true;
        }

        if (email && emails.has(email.toLowerCase())) {
            rowErrors.push('Email bị trùng');
            hasError = true;
        } else if (email) {
            emails.add(email.toLowerCase());
        }

        if (sdt && !validatePhone(sdt)) {
            rowErrors.push('SĐT không hợp lệ (phải là 10 số, bắt đầu bằng 0)');
            hasError = true;
        }

        if (sdt && phones.has(sdt)) {
            rowErrors.push('SĐT bị trùng');
            hasError = true;
        } else if (sdt) {
            phones.add(sdt);
        }

        if (vaiTro && !validateRole(vaiTro)) {
            rowErrors.push('Vai trò không hợp lệ');
            hasError = true;
        }

        if (hasError) {
            tr.classList.add('error-row');
            errorCount++;
            errors.push(`Dòng ${rowNum}: ${rowErrors.join(', ')}`);
        } else {
            validCount++;
            validatedData.push({
                HoTen: hoTen,
                Email: email,
                SDT: sdt,
                VaiTro: vaiTro,
            });
        }

        tr.insertCell(0).textContent = rowNum;

        const hoTenCell = tr.insertCell(1);
        hoTenCell.textContent = hoTen || '(Trống)';
        if (!hoTen) hoTenCell.classList.add('error-cell');

        const emailCell = tr.insertCell(2);
        emailCell.textContent = email || '(Trống)';
        if (!email || !validateEmail(email)) {
            emailCell.classList.add('error-cell');
        }

        const sdtCell = tr.insertCell(3);
        sdtCell.textContent = sdt || '(Trống)';
        if (!sdt || !validatePhone(sdt)) {
            sdtCell.classList.add('error-cell');
        }

        const vaiTroCell = tr.insertCell(4);
        vaiTroCell.textContent = vaiTro || '(Trống)';
        if (!vaiTro || !validateRole(vaiTro)) {
            vaiTroCell.classList.add('error-cell');
        }

        const statusCell = tr.insertCell(5);
        if (hasError) {
            statusCell.innerHTML = '<span class="status-error">❌ Lỗi</span>';
        } else {
            statusCell.innerHTML = '<span class="status-valid">✅ Hợp lệ</span>';
        }
    });

    // Hiển thị tổng kết
    document.getElementById('rowCount').textContent = data.length;
    document.getElementById('validCount').textContent = validCount;
    document.getElementById('errorCount').textContent = errorCount;

    // Hiển thị danh sách lỗi
    if (errors.length > 0) {
        errors.forEach(error => {
            const li = document.createElement('li');
            li.textContent = error;
            validationList.appendChild(li);
        });
        document.getElementById('validationSummary').style.display = 'block';
    }

    // Lưu dữ liệu hợp lệ vào hidden input
    document.getElementById('validDataJson').value = JSON.stringify(validatedData);

    // Disable nút submit nếu có lỗi
    const submitBtn = document.getElementById('submitBtn');
    if (errorCount > 0) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
        submitBtn.title = 'Vui lòng sửa các lỗi trước khi import';
    } else {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        submitBtn.title = '';
    }

    document.getElementById('importPreview').style.display = 'block';
}
</script>